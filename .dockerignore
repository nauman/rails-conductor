# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Documentation and tests never run in production (2026-09-12). Only files the app
# reads at runtime are re-included; add a line here when a new runtime read lands.
#
# Updated for the docs/ -> documents/ split (2026-09-24). docs/ is private working
# notes and never ships. documents/ is public product docs and mostly does not
# need to either — but two paths ARE read at runtime and their absence would be a
# 500, not a missing file:
#   documents/skills/conductor/SKILL.md  -> served at GET /mcp/skill
#   documents/guides/                    -> read by app/models/guide.rb
# The previous re-includes named docs/guides and docs/skills, which no longer
# exist, so they matched nothing while documents/ shipped whole.
/docs/**
/documents/**
!/documents/guides/**
!/documents/skills/**
/test
