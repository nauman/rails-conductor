#!/usr/bin/env bash
# LOCAL-FIRST CI — pre-push gate (fleet doctrine).
# GitHub Actions no longer runs CI on push (workflow_dispatch-only), so this is the
# enforcement: runs the local audit on the delta being pushed and BLOCKS a red push.
#   • asdf ruby (bare shell may pick up system ruby)  • PARALLEL_WORKERS=1 (macOS forker)
#   • forkers (test/system/*, og_card) EXCLUDED — covered by a prod curl, not CI.
# Docs-only pushes skip. Escape hatch: `git push --no-verify`.
# Doctrine: https://kuickr.co/dev-docs-74/infra/local-ci-doctrine.html
set -uo pipefail
export PATH="$HOME/.asdf/shims:$PATH"
export PARALLEL_WORKERS=1
base="$(git merge-base origin/main HEAD 2>/dev/null || true)"
[ -z "${base:-}" ] && base="$(git rev-parse HEAD~1 2>/dev/null || echo HEAD)"
changed="$(git diff --name-only "$base"..HEAD 2>/dev/null || true)"

# The DEPLOY CONFIG gate. Two consecutive deploys failed at kamal's config load —
# once for a destination overlay this repo does not carry, once for the
# `require_destination` flag that demanded it — and no gate could see either: the
# test suite does not evaluate config/deploy.yml, and a workflow-only change used to
# read as "docs". `kamal config` renders it in about a second and needs no secrets.
# Validate with the SAME flags CI will use, since the failure was a mismatch BETWEEN
# the workflow and the config, which neither file reveals alone.
if printf '%s\n' "$changed" | grep -qE '^(config/deploy.*\.yml|\.kamal/|\.github/workflows/deploy\.yml)'; then
  dest="$(grep -oE 'bin/kamal deploy( +-d +[A-Za-z0-9_-]+)?' .github/workflows/deploy.yml 2>/dev/null | head -1 | sed -nE 's/.*-d +([A-Za-z0-9_-]+).*/\1/p')"
  echo "pre-push: validating the deploy config as CI invokes it (${dest:+-d $dest}${dest:+ }base)"
  # shellcheck disable=SC2086
  if ! bin/kamal config ${dest:+-d "$dest"} >/dev/null 2>/tmp/kamal-config-check.$$; then
    echo "pre-push: ✗ deploy config is invalid for this invocation — CI would fail at config load:" >&2
    sed 's/^/    /' /tmp/kamal-config-check.$$ >&2; rm -f /tmp/kamal-config-check.$$
    echo "  Fix the config/workflow pair, or: git push --no-verify" >&2
    exit 1
  fi
  rm -f /tmp/kamal-config-check.$$
  echo "pre-push: ✓ deploy config renders."
fi

code_changed=0; tests=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  # .github/** counts as code: a workflow change deploys differently, and calling it
  # "docs" is how a broken deploy invocation reached main unexercised.
  case "$f" in app/*|lib/*|config/*|db/*|test/*|.github/*|Gemfile|Gemfile.lock) code_changed=1 ;; esac
  case "$f" in
    test/system/*) : ;;
    *og_card*) : ;;
    test/*_test.rb) [ -f "$f" ] && tests="$tests $f" ;;
  esac
done <<< "$changed"
if [ "$code_changed" -eq 0 ]; then echo "pre-push: docs-only delta — skipping local CI."; exit 0; fi
if [ -z "${tests// /}" ]; then
  echo "pre-push: code changed but no changed *_test.rb — run relevant tests manually (advisory)."; exit 0
fi
echo "pre-push: running changed tests (PARALLEL_WORKERS=1):$tests"
# shellcheck disable=SC2086
if bin/rails test $tests; then echo "pre-push: ✓ green — push allowed."; exit 0
else echo "pre-push: ✗ RED — push blocked. Fix, or: git push --no-verify" >&2; exit 1; fi
