<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Conductor" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Conductor">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# SEO + social cards %>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Conductor — the control plane for self-hosted Ruby on Rails. Deploy, route, databases, backups, and server maintenance across your own servers (Kamal, Docker, native), driven by UI, CLI, and AI agents over MCP." %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Conductor">
    <meta property="og:title" content="<%= content_for?(:title) ? strip_tags(yield(:title)) : "Conductor — control plane for self-hosted Ruby on Rails" %>">
    <meta property="og:description" content="Deploy, route, databases, backups, and server maintenance for your Ruby on Rails apps across your own servers — Kamal, Docker, native — driven by UI, CLI, and AI agents over MCP.">
    <meta property="og:image" content="<%= request.base_url %>/og.png">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Conductor — control plane for self-hosted Ruby on Rails">
    <meta name="twitter:description" content="Self-hosted Ruby on Rails ops: deploy, route, databases, backups, maintenance — UI, CLI, and AI agents over MCP.">
    <meta name="twitter:image" content="<%= request.base_url %>/og.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-bg text-body font-sans antialiased">
    <%# overflow-x-clip lives on the page shell (not the header) so it contains
        horizontal overflow WITHOUT making the header a clip boundary for the
        nav/account dropdowns that hang below it. %>
    <div class="min-h-screen flex flex-col overflow-x-clip" data-app-shell>
      <header class="sticky top-0 z-30 border-b border-border bg-surface/85 backdrop-blur">
        <div class="mx-auto max-w-[88rem] min-w-0 px-2 sm:px-4">
          <div class="flex h-16 min-w-0 items-center gap-2 sm:gap-3" data-primary-header>
            <%= link_to (user_signed_in? ? dashboard_path : root_path), class: "flex items-center gap-2.5 shrink-0" do %>
              <span class="h-9 w-9 rounded-card bg-primary text-white flex items-center justify-center font-display text-lg leading-none">C</span>
              <span class="hidden leading-tight xl:block">
                <span class="block font-display text-lg text-ink">Conductor</span>
                <span class="block text-2xs uppercase tracking-label text-faint">Ops control panel</span>
              </span>
            <% end %>

            <% if user_signed_in? %>
              <%
                data_active     = %w[/backups /database_clusters /database_pulls].any? { |p| request.path.start_with?(p) }
                settings_active = %w[/credentials /ssh_keys /members /mcp_tokens /organizations /integrations /admin].any? { |p| request.path.start_with?(p) }
              %>
              <%# Scrollable on mobile so no item is clipped/unreachable; at md+
                  overflow is visible so the Data/Settings dropdowns can hang down. %>
              <nav class="min-w-0 flex-1 overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:overflow-x-visible md:overflow-y-visible" data-primary-navigation aria-label="Primary navigation">
                <div class="flex items-center gap-0.5 whitespace-nowrap text-[13px] font-medium">
                  <%= nav_link "Overview", dashboard_path, active: request.path == dashboard_path %>
                  <%= nav_link "Servers", servers_path, active: request.path.start_with?('/servers') %>
                  <%= nav_link "Apps", apps_path, active: request.path.start_with?('/apps') %>
                  <%= nav_group "Data", active: data_active do %>
                    <%= nav_menu_link "Backups", backups_path, active: request.path.start_with?('/backups') %>
                    <%= nav_menu_link "Databases", database_clusters_path, active: request.path.start_with?('/database_clusters') %>
                    <%= nav_menu_link "Pulls", database_pulls_path, active: request.path.start_with?('/database_pulls') %>
                  <% end %>
                  <%= nav_link "Rituals", rituals_path, active: request.path.start_with?('/rituals') %>
                  <%= nav_link "Chat", conversations_path, active: request.path.start_with?('/conversations') %>
                  <%= nav_group "Settings", active: settings_active do %>
                    <%= nav_menu_link "Members", members_path, active: request.path.start_with?('/members') %>
                    <%= nav_menu_link "Organizations", organizations_path, active: request.path.start_with?('/organizations') %>
                    <%= nav_menu_link "SSH Keys", ssh_keys_path, active: request.path.start_with?('/ssh_keys') %>
                    <%= nav_menu_link "Credentials", credentials_path, active: request.path.start_with?('/credentials') %>
                    <%= nav_menu_link "API Tokens", mcp_tokens_path, active: request.path.start_with?('/mcp_tokens') %>
                    <% if current_admin? %>
                      <div class="my-1 border-t border-border"></div>
                      <%= nav_menu_link "Integrations", integrations_path, active: request.path.start_with?('/integrations') %>
                      <%= nav_menu_link "Admin", admin_organizations_path, active: request.path.start_with?('/admin') %>
                    <% end %>
                  <% end %>
                </div>
              </nav>

              <div class="flex max-w-full shrink-0 items-center gap-2 border-l border-border pl-2 sm:gap-3" data-account-controls>
                <div class="hidden md:block">
                  <%= render "organizations/switcher" %>
                </div>
                <div class="hidden xl:flex items-center gap-2">
                  <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-fill text-2xs font-semibold uppercase text-body" title="<%= current_user.email %>"><%= current_user.email.to_s[0]&.upcase %></span>
                  <div class="flex flex-col items-start leading-tight">
                    <span class="text-2xs text-body max-w-[12rem] truncate"><%= current_user.email %></span>
                    <% if current_admin? %>
                      <span class="mt-0.5 rounded-full bg-warning-tint px-1.5 py-px text-[10px] font-semibold uppercase tracking-label text-warning-deep">Admin</span>
                    <% end %>
                  </div>
                </div>
                <%= button_to "Sign out", user_sign_out_path, method: :delete, class: "shrink-0 whitespace-nowrap rounded-pill border border-border px-3 py-1.5 text-2xs font-semibold uppercase tracking-label text-muted hover:border-border-strong hover:bg-fill-strong hover:text-ink" %>
              </div>
            <% else %>
              <div class="flex-1"></div>
              <%= link_to "Sign in", user_sign_in_path, class: "shrink-0 px-4 py-1.5 rounded-pill bg-ink text-white text-sm font-medium hover:bg-body" %>
            <% end %>
          </div>
        </div>
      </header>

      <main class="flex-1">
        <% if notice.present? %>
          <div class="bg-primary-tint border-b border-primary/30">
            <div class="max-w-7xl mx-auto px-4 py-3">
              <p class="text-sm text-primary"><%= notice %></p>
            </div>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="bg-danger-tint border-b border-danger/30">
            <div class="max-w-7xl mx-auto px-4 py-3">
              <p class="text-sm text-danger-deep"><%= alert %></p>
            </div>
          </div>
        <% end %>
        <%= yield %>
      </main>

      <footer class="border-t border-border bg-surface">
        <div class="max-w-7xl mx-auto px-4 py-6 text-xs text-muted flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <span>Conductor · control plane for self-hosted Rails</span>
          <%# Says what it does today. Active Storage introspection is deferred, and the
              footer shouldn't advertise it (docs/dev/FEATURES.md). %>
          <span>Servers, deploys, databases, backups</span>
        </div>
      </footer>
    </div>
  </body>
</html>
