<% content_for :title, "Users · Conductor" %>

<%= render partial: "shared/page_head",
      locals: {
        title: "#{pluralize(@users.size, "person")} can sign in.",
        lede: "Admins can manage servers, apps and credentials for this instance.",
        stats: [
          { value: @users.size, label: "users" },
          { value: @users.count(&:admin?), label: "admins" }
        ]
      } %>

<section class="max-w-4xl mx-auto px-4 py-8 space-y-5">
  <%= render layout: "shared/panel", locals: { title: "Add someone" } do %>
    <%= form_tag users_path, method: :post, class: "flex flex-wrap items-end gap-3" do %>
      <div class="min-w-48 flex-1">
        <label for="email" class="mb-1 block font-mono text-2xs uppercase tracking-label text-muted">Email</label>
        <input type="email" name="email" id="email" required placeholder="person@example.com"
               class="block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary">
      </div>
      <label class="flex items-center gap-2 pb-2 text-sm text-body">
        <input type="checkbox" name="admin" value="1" class="rounded border-border-strong text-ink focus:ring-primary">
        Admin
      </label>
      <button type="submit" class="rounded-control bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-strong">Add user</button>
    <% end %>
    <p class="mt-2 font-mono text-2xs text-faint">They sign in with an emailed link — no password to set or leak.</p>
  <% end %>

  <%= render layout: "shared/panel", locals: { title: "People", flush: true } do %>
    <div class="divide-y divide-border">
      <% @users.each do |user| %>
        <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3">
          <div class="min-w-0">
            <span class="text-sm font-medium text-ink"><%= user.email %></span>
            <% if user == current_user %><span class="ml-1 font-mono text-2xs text-faint">you</span><% end %>
            <div class="font-mono text-2xs text-faint">
              <%= user.admin? ? "admin" : "member" %> · joined <%= user.created_at.strftime("%b %d, %Y") %>
            </div>
          </div>
          <% if user != current_user %>
            <div class="flex shrink-0 items-center gap-2">
              <%= rui_button_to((user.admin? ? "Remove admin" : "Make admin"), toggle_admin_user_path(user), method: :patch,
                    variant: :ghost, size: :sm, color: :slate) %>
              <%= rui_button_to("Remove", user_path(user), method: :delete, variant: :ghost, size: :sm, color: :danger,
                    data: { turbo_confirm: "Remove #{user.email}?" }) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
