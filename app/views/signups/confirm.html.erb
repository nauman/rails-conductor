<% content_for :title, "Create your account · Conductor" %>

<section class="min-h-[60vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md rounded-large border border-border bg-surface p-8 shadow-soft text-center">
    <h1 class="font-display text-xl text-ink">Create your Conductor account</h1>
    <p class="mt-2 text-sm text-muted">for <strong><%= @intent.email %></strong></p>
    <%= button_to "Create my account", verify_signup_path(token: @token), method: :post,
          class: "mt-6 w-full cursor-pointer rounded-control bg-ink px-4 py-2.5 text-sm font-medium text-white" %>
    <p class="mt-4 text-xs text-faint">Not you? Close this page — nothing has been created.</p>
  </div>
</section>
