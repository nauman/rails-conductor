<% content_for :title, "New SSH Key · Conductor" %>

<section class="max-w-2xl mx-auto px-4 py-10">
  <div class="mb-8">
    <h1 class="font-display text-2xl text-ink tracking-display">New SSH Key</h1>
    <p class="mt-1 text-sm text-muted">Conductor connects to your servers over SSH — it needs a key to do that.</p>
  </div>

  <%# Recommended: Conductor generates and holds the key; you only authorize the
      public half on your servers. Nothing is generated on your machine. %>
  <div class="rounded-large border border-primary/30 bg-primary-tint p-6 shadow-soft">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-sm font-semibold text-ink">Generate a deploy key <span class="ml-1 rounded-pill bg-primary px-2 py-0.5 text-2xs font-semibold uppercase tracking-label text-white">Recommended</span></h2>
        <p class="mt-1 text-sm text-body">
          Conductor creates the keypair on its own server and keeps the private half
          encrypted. You just add the <strong>public</strong> key it shows you to each
          server's <code class="text-2xs">authorized_keys</code> — the same way managed platforms do it.
        </p>
      </div>
    </div>
    <%= form_with url: generate_ssh_keys_path, method: :post, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
      <div class="flex-1 min-w-48">
        <%= label_tag :name, "Key name", class: "block text-xs font-medium text-body" %>
        <%= text_field_tag :name, "Conductor deploy key", class: "mt-1 block w-full rounded-lg border-border-strong shadow-soft focus:border-primary focus:ring-primary sm:text-sm" %>
      </div>
      <%= f.submit "Generate key", class: "cursor-pointer rounded-lg bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-body" %>
    <% end %>
  </div>

  <div class="my-8 flex items-center gap-3 text-xs uppercase tracking-label text-faint">
    <span class="h-px flex-1 bg-border"></span> or paste an existing private key <span class="h-px flex-1 bg-border"></span>
  </div>

  <%= render "form", ssh_key: @ssh_key %>
</section>
