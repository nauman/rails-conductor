<% content_for :title, "SSH Keys · Conductor" %>

<%# SSH is how Conductor reaches every box, so a key with no server attached is usually a
    setup that was never finished — worth saying, not just listing. %>
<% unattached = @ssh_keys.select { |k| k.servers.empty? } %>
<%= render layout: "shared/page_head",
      locals: {
        title: @ssh_keys.empty? ? "No keys — Conductor can't reach any server." : "#{pluralize(@ssh_keys.size, "key")} for #{pluralize(@ssh_keys.sum { |k| k.servers.count }, "server")}.",
        lede: "Conductor connects over plain SSH — no agent on your boxes. It holds the private half, encrypted; the public half lives in the server's authorized_keys.",
        stats: [
          { value: @ssh_keys.size, label: "keys" },
          ({ value: unattached.size, label: "attached to nothing", tone: :warning } if unattached.any?)
        ].compact
      } do %>
  <%= rui_button("Add SSH key", url: new_ssh_key_path, color: :primary, size: :md) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8 space-y-5">
  <% if @ssh_keys.any? %>
    <%= render layout: "shared/panel", locals: { title: "Keys", flush: true } do %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="bg-fill font-mono text-2xs uppercase tracking-label text-muted">
              <th class="px-5 py-2 text-left font-semibold">Name</th>
              <th class="px-5 py-2 text-left font-semibold">Type</th>
              <th class="px-5 py-2 text-left font-semibold">Fingerprint</th>
              <th class="px-5 py-2 text-left font-semibold">In use by</th>
              <th class="px-5 py-2 text-right font-semibold"></th>
            </tr>
          </thead>
          <tbody>
            <% @ssh_keys.each do |ssh_key| %>
              <tr class="border-t border-border hover:bg-bg-alt">
                <td class="px-5 py-2.5">
                  <%= link_to ssh_key.name, ssh_key_path(ssh_key), class: "font-medium text-ink hover:underline" %>
                </td>
                <td class="px-5 py-2.5 font-mono text-2xs text-muted"><%= ssh_key.key_type || "unknown" %></td>
                <td class="px-5 py-2.5 font-mono text-2xs text-muted"><%= ssh_key.fingerprint&.truncate(30) || "—" %></td>
                <td class="px-5 py-2.5 font-mono text-2xs <%= ssh_key.servers.empty? ? "text-warning-deep" : "text-muted" %>">
                  <%= ssh_key.servers.empty? ? "no servers" : pluralize(ssh_key.servers.count, "server") %>
                </td>
                <td class="whitespace-nowrap px-5 py-2.5 text-right">
                  <%= rui_button("Edit", url: edit_ssh_key_path(ssh_key), variant: :ghost, size: :sm, color: :slate) %>
                  <%= rui_button_to("Delete", ssh_key_path(ssh_key), method: :delete, variant: :ghost, size: :sm, color: :danger,
                        data: { turbo_confirm: "Delete #{ssh_key.name}? Any server using it loses access." }) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-large border border-dashed border-border-strong bg-fill p-12 text-center">
      <h2 class="font-display text-xl text-ink">No SSH keys yet</h2>
      <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
        Without one, Conductor can read nothing and deploy nowhere. Let it generate a
        dedicated key — then you can revoke its access by deleting one line on a server.
      </p>
      <%= rui_button "Add your first SSH key", url: new_ssh_key_path, color: :primary, class: "mt-5" %>
    </div>
  <% end %>

  <%= render layout: "shared/panel", locals: { title: "Setting one up", meta: "about a minute" } do %>
    <p class="text-sm text-muted">
      A key is a pair: a <strong class="text-body">public</strong> half that lives on the
      server (it says "trust whoever holds the match"), and a
      <strong class="text-body">private</strong> half Conductor holds, encrypted at rest.
    </p>
    <ol class="mt-4 space-y-3 text-sm text-body">
      <li class="flex gap-3">
        <span class="font-mono text-2xs text-faint">01</span>
        <span>
          <strong class="font-medium">Let Conductor generate it</strong> — choose
          <em>Generate a deploy key</em>. The keypair is created here and the private half
          never leaves; you generate nothing on your own machine.
        </span>
      </li>
      <li class="flex gap-3">
        <span class="font-mono text-2xs text-faint">02</span>
        <span>
          <strong class="font-medium">Authorize the public half</strong> on the box, for the
          user Conductor logs in as:
          <code class="mt-1.5 block rounded-card bg-fill px-2 py-1 font-mono text-2xs">ssh-copy-id -i &lt;key&gt;.pub deploy@YOUR_SERVER_IP</code>
        </span>
      </li>
      <li class="flex gap-3">
        <span class="font-mono text-2xs text-faint">03</span>
        <span>
          <strong class="font-medium">Attach it to a server</strong> and hit
          <em>Test connection</em> to confirm before relying on it.
        </span>
      </li>
    </ol>
    <p class="mt-4 text-2xs text-faint">
      You can paste an existing private key instead — but a dedicated key means revoking
      Conductor's access is one line in <code>authorized_keys</code>, not a rotation.
    </p>
  <% end %>
</section>
