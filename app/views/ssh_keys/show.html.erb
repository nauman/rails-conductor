<% content_for :title, "#{@ssh_key.name} · Conductor" %>

<%= render layout: "shared/page_head",
      locals: {
        eyebrow: "#{@ssh_key.key_type || "unknown"} key",
        title: @ssh_key.name,
        lede: "Conductor holds the private half encrypted. The public half below goes in each server's authorized_keys.",
        stats: [
          { value: @ssh_key.servers.count, label: "servers using it",
            tone: @ssh_key.servers.empty? ? :warning : :default },
          { value: "#{time_ago_in_words(@ssh_key.created_at)} ago", label: "added" }
        ]
      } do %>
  <%= rui_button("Edit", url: edit_ssh_key_path(@ssh_key), variant: :outline, color: :slate) %>
  <%= rui_button("All keys", url: ssh_keys_path, variant: :outline, color: :slate) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8">
  <div class="grid gap-5 lg:grid-cols-2">
    <div class="rounded-large border border-border bg-surface p-6 shadow-soft">
      <h2 class="text-sm font-semibold text-ink">Key details</h2>
      <dl class="mt-4 space-y-4">
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Fingerprint</dt>
          <dd class="mt-1 text-sm text-ink font-mono"><%= @ssh_key.fingerprint || "—" %></dd>
        </div>
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Key Type</dt>
          <dd class="mt-1 text-sm text-ink"><%= @ssh_key.key_type || "Unknown" %></dd>
        </div>
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Has Passphrase</dt>
          <dd class="mt-1 text-sm text-ink"><%= @ssh_key.passphrase.present? ? "Yes" : "No" %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-large border border-border bg-surface p-6 shadow-soft" data-controller="rapid-rails-ui--clipboard" data-rapid-rails-ui--clipboard-target-value="ssh-public-key">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-ink">Public key</h2>
        <% if @ssh_key.public_key.present? %>
          <button type="button" data-action="rapid-rails-ui--clipboard#copy" class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-fill px-2.5 py-1 text-xs font-medium text-body hover:bg-fill-strong">
            <span data-rapid-rails-ui--clipboard-target="defaultMessage">Copy</span>
            <span data-rapid-rails-ui--clipboard-target="successMessage" class="opacity-0 pointer-events-none text-primary">Copied!</span>
          </button>
        <% end %>
      </div>
      <p class="mt-1 text-xs text-muted">Conductor connects to your servers with this key. Add the public half to each server so it trusts Conductor.</p>
      <% if @ssh_key.public_key.present? %>
        <textarea id="ssh-public-key" readonly rows="3" class="mt-3 block w-full rounded-control bg-fill p-3 font-mono text-2xs text-body break-all resize-none focus:outline-none"><%= @ssh_key.public_key %></textarea>
        <div class="mt-3 rounded-card border border-border bg-bg-alt p-3 text-2xs text-muted">
          <div class="font-medium text-body">Authorize it on a server</div>
          <p class="mt-1">Log into the server as the user Conductor will use (e.g. <code class="text-2xs">deploy</code> or <code class="text-2xs">root</code>) and append the line above to <code class="text-2xs">~/.ssh/authorized_keys</code> — or from your machine:</p>
          <code class="mt-1.5 block bg-surface px-2 py-1 rounded text-2xs break-all">ssh-copy-id -i &lt;this-key&gt;.pub deploy@YOUR_SERVER_IP</code>
          <p class="mt-1.5">Then attach this key to the server (Servers → edit → SSH key) and hit <em>Test connection</em>.</p>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-muted">Public key not available.</p>
      <% end %>
    </div>
  </div>

  <% if @ssh_key.servers.any? %>
    <div class="mt-5">
      <%= render layout: "shared/panel",
            locals: { title: "Servers using this key", flush: true,
                      meta: "deleting the key cuts Conductor off from all of them" } do %>
        <div class="divide-y divide-border">
          <% @ssh_key.servers.each do |server| %>
            <div class="flex items-center justify-between gap-3 px-5 py-3">
              <div class="min-w-0">
                <%= link_to server.name, server_path(server), class: "text-sm font-medium text-ink hover:underline" %>
                <div class="font-mono text-2xs text-faint"><%= server.ip_address || "no IP" %></div>
              </div>
              <span class="<%= status_badge(server.display_status) %>"><%= server.display_status %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-5 rounded-large border border-border bg-surface px-5 py-4 shadow-soft">
    <%= rui_button_to("Delete SSH key", ssh_key_path(@ssh_key), method: :delete, variant: :link, color: :danger, size: :sm,
          data: { turbo_confirm: (@ssh_key.servers.any? ? "Delete #{@ssh_key.name}? #{@ssh_key.servers.count} server(s) use it and Conductor will lose access." : "Delete #{@ssh_key.name}?") }) %>
  </div>
</section>
