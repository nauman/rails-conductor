<% content_for :title, "Organizations · Conductor" %>

<%= render layout: "shared/page_head",
      locals: {
        title: "You belong to #{pluralize(@organizations.size, "workspace")}.",
        lede: "Each organization has its own servers, apps, databases, backups and members — nothing crosses between them.",
        stats: [ { value: current_organization.name, label: "active now" } ]
      } do %>
  <%= rui_button("New organization", url: new_organization_path, color: :primary, size: :md) %>
<% end %>

<section class="mx-auto max-w-3xl px-4 py-8">
  <div class="rounded-large border border-border bg-surface shadow-soft">
    <ul class="divide-y divide-border">
      <% @organizations.each do |org| %>
        <li class="flex items-center justify-between px-5 py-4">
          <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-ink"><%= org.name %></span>
            <% if org.id == current_organization&.id %>
              <%= rui_badge(text: "active", color: :primary, size: :sm) %>
            <% end %>
            <% if org.owner?(current_user) %>
              <%= rui_badge(text: "owner", color: :slate, size: :sm) %>
            <% end %>
          </div>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-xs text-faint"><%= pluralize(org.users.size, "member") %></span>
            <% if org.id == current_organization&.id %>
              <span class="text-xs font-medium text-muted">Current</span>
            <% else %>
              <%= button_to "Switch", switch_organization_path(org), class: "font-medium text-primary hover:underline cursor-pointer" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <p class="mt-4 text-xs text-faint">
    Invite people into an organization from the
    <%= link_to "Members", members_path, class: "underline hover:text-body" %> page.
  </p>
</section>
