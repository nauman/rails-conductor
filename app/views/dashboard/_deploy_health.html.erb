<%# Deploy health — the design's honest metric. Shows attempts against failures, because
    the ratio is the story: 29 deploys with 11 failures is a different week from 29 clean
    ones. The headline counts APPS currently broken, not historical failures, so a problem
    fixed an hour ago stops shouting. %>
<div class="rounded-large border border-border bg-surface shadow-soft">
  <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-3">
    <h2 class="text-sm font-semibold text-ink">Deploy health</h2>
    <span class="font-mono text-2xs text-faint">last 7 days</span>
  </div>
  <div class="px-5 py-4">
    <div class="font-display text-3xl tracking-display <%= failing.positive? ? 'text-danger' : 'text-primary' %>">
      <%= failing %><span class="ml-1 font-mono text-xs text-muted"><%= failing == 1 ? "app failing now" : "apps failing now" %></span>
    </div>

    <%# One bar per day: total attempts, with the failed share filled in. Empty days are a
        faint baseline so a quiet week doesn't look like missing data. %>
    <div class="mt-4 flex h-12 items-end gap-1.5">
      <% max = [ days.map { |(_, total, _)| total }.max || 0, 1 ].max %>
      <% days.each do |(date, total, failed)| %>
        <div class="flex-1" title="<%= date.strftime('%b %d') %>: <%= total %> deploys, <%= failed %> failed">
          <div class="relative w-full rounded-t bg-fill" style="height: <%= [ (total * 100.0 / max).round, 4 ].max %>%; min-height: 4px;">
            <% if failed.positive? %>
              <div class="absolute bottom-0 w-full rounded-t bg-danger-tint" style="height: <%= (failed * 100.0 / total).round %>%"></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <p class="mt-3 text-2xs text-muted">
      <% if total.zero? %>
        No deploys this week.
      <% else %>
        <span class="font-medium text-ink"><%= total %></span> deploys,
        <span class="font-medium <%= failed.positive? ? 'text-danger' : 'text-ink' %>"><%= failed %></span> failed.
        <%= "Failures a later deploy fixed are closed — only currently-broken apps count above." if failed.positive? %>
      <% end %>
    </p>
  </div>
</div>
