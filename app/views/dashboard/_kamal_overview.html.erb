<div class="rounded-large border border-border bg-surface p-4 shadow-soft sm:p-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="font-display text-xl text-ink">Fleet status</h2>
      <p class="text-sm text-muted">Desired state, observed runtime, and monitoring confidence across your apps.</p>
    </div>
    <%= rui_button_to("Sync all", sync_all_apps_path, method: :post, variant: :outline, size: :sm, color: :slate) %>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-card bg-primary-tint p-3 text-center">
      <div class="font-mono text-2xl font-semibold text-primary" data-container-stat="running"><%= @kamal_stats[:running_apps] %></div>
      <div class="text-2xs font-medium uppercase tracking-label text-primary-strong">Running</div>
    </div>
    <div class="rounded-card bg-danger-tint p-3 text-center">
      <div class="font-mono text-2xl font-semibold text-danger-deep" data-container-stat="stopped"><%= @kamal_stats[:stopped_apps] %></div>
      <div class="text-2xs font-medium uppercase tracking-label text-danger">Stopped</div>
    </div>
    <div class="rounded-card bg-fill p-3 text-center">
      <div class="font-mono text-2xl font-semibold text-body" data-container-stat="unknown"><%= @kamal_stats[:unknown_status] %></div>
      <div class="text-2xs font-medium uppercase tracking-label text-muted">Not observed</div>
    </div>
    <div class="rounded-card bg-bg-alt p-3 text-center">
      <div class="font-mono font-display text-2xl text-ink tracking-display" data-container-stat="total"><%= @kamal_stats[:total_apps] %></div>
      <div class="text-2xs font-medium uppercase tracking-label text-muted">Total</div>
    </div>
  </div>

  <% if @apps_by_server.any? %>
    <div class="mt-6 space-y-4">
      <% @apps_by_server.each do |server, apps| %>
        <div class="overflow-hidden rounded-card border border-border">
          <div class="flex items-center justify-between border-b border-border bg-fill px-4 py-2">
            <div class="flex min-w-0 items-center gap-2">
              <% if server %>
                <span class="h-2 w-2 shrink-0 rounded-pill <%= server.display_status == 'online' ? 'bg-primary' : server.display_status == 'degraded' ? 'bg-warning-bright' : server.display_status == 'pending' ? 'bg-border-strong' : 'bg-danger-bright' %>"></span>
                <%= link_to server.name, server_path(server), class: "truncate text-sm font-medium text-ink hover:underline" %>
              <% else %>
                <span class="h-2 w-2 shrink-0 rounded-pill bg-faint"></span>
                <span class="text-sm font-medium text-muted">No server</span>
              <% end %>
            </div>
            <%= rui_badge(text: pluralize(apps.count, "app"), color: :slate, size: :sm) %>
          </div>

          <div class="divide-y divide-border">
            <% apps.each do |app| %>
              <% health = @app_health.fetch(app) %>
              <div class="flex flex-col gap-3 px-4 py-3 hover:bg-fill sm:flex-row sm:items-center sm:justify-between" data-fleet-app="<%= app.name %>">
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="h-2 w-2 shrink-0 rounded-pill <%= health.summary_state == 'running' ? 'bg-primary' : health.summary_state == 'stopped' ? 'bg-danger-bright' : 'bg-faint' %>"></span>
                    <%= link_to app.name, app_path(app), class: "truncate text-sm font-semibold text-ink hover:underline" %>
                  </div>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 pl-4 text-2xs text-muted">
                    <span data-health-dimension="desired">Desired: <strong class="font-medium text-body"><%= health.desired_state.humanize %></strong></span>
                    <span data-health-dimension="observed">Observed: <strong class="font-medium text-body"><%= health.monitoring_state == 'unsupported' ? 'Not monitored' : health.observed_state.humanize %></strong></span>
                    <span data-health-dimension="monitoring" class="<%= health.monitoring_state.in?(%w[failed stale unavailable]) ? 'text-warning' : '' %>"><%= health.monitoring_label %></span>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 pl-4 sm:justify-end sm:pl-0">
                  <%= turbo_frame_tag "app_jobs_#{app.id}", src: jobs_app_path(app), loading: :lazy do %>
                    <span class="text-2xs text-faint">Jobs…</span>
                  <% end %>
                  <%= rui_button("Logs", url: logs_app_path(app), variant: :ghost, size: :sm, color: :slate) %>
                  <% if app.can_sync_status? %>
                    <%= rui_button_to("Sync", sync_status_app_path(app), method: :post, variant: :outline, size: :sm, color: :slate) %>
                  <% end %>
                  <% if app.dashboard_restart_supported? %>
                    <%= rui_button_to("Restart", restart_app_path(app), method: :post, variant: :outline, size: :sm, color: :slate, data: { turbo_confirm: "Restart #{app.name}?" }) %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-6 rounded-card border border-dashed border-border bg-fill p-6 text-center">
      <p class="text-sm text-muted">No apps registered yet.</p>
      <%= rui_button("Add an app", url: new_app_path, variant: :link, color: :primary, class: "mt-2") %>
    </div>
  <% end %>
</div>
