<%# Ops header (design: conductor/design/fleet.html). The page opens with the fleet's
    condition and the counts that qualify it — no hero, no static tip. What used to be four
    large tiles and a marketing promise is one line and a strip, because the space belongs
    to what needs you. %>
<section class="border-b border-border bg-bg-alt">
  <div class="max-w-7xl mx-auto px-4 py-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <% criticals = @issues.count { |i| i[:severity] == "critical" } %>
          <span class="h-2 w-2 rounded-pill <%= criticals.positive? ? 'bg-danger-bright' : @issues.any? ? 'bg-warning-bright' : 'bg-primary' %>"></span>
          <span class="font-mono text-2xs uppercase tracking-label text-muted"><%= current_organization.name %></span>
        </div>
        <h1 class="mt-1 font-display text-3xl text-ink tracking-display">
          <% if criticals.positive? %>
            <%= pluralize(criticals, "thing") %> need<%= "s" if criticals == 1 %> you now.
          <% elsif @issues.any? %>
            Nothing urgent, <%= pluralize(@issues.size, "thing") %> to look at.
          <% else %>
            Everything is running.
          <% end %>
        </h1>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Servers", servers_path, class: "rounded-control border border-border-strong bg-surface px-3 py-2 text-sm font-medium text-body hover:bg-fill" %>
        <%= link_to "Apps", apps_path, class: "rounded-control border border-border-strong bg-surface px-3 py-2 text-sm font-medium text-body hover:bg-fill" %>
        <%= link_to "New app", new_app_path, class: "rounded-control bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary-strong" %>
      </div>
    </div>

    <%# Counts as a strip, not as cards: they are context for the headline, not the point
        of the page. Backups is the exception — it turns red because zero is dangerous. %>
    <% unprotected = @apps.count { |a| a.naggable? && a.backups.empty? } %>
    <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs">
      <%= link_to servers_path, class: "text-muted hover:text-ink" do %>
        <span class="text-ink font-semibold"><%= @stats[:servers_count] %></span> servers<%= ", #{@stats[:servers_degraded]} degraded" if @stats[:servers_degraded].to_i.positive? %>
      <% end %>
      <%= link_to apps_path, class: "text-muted hover:text-ink" do %>
        <span class="text-ink font-semibold"><%= @stats[:apps_count] %></span> apps<%= ", #{@apps_failing.size} failing" if @apps_failing.any? %>
      <% end %>
      <%= link_to backups_path, class: "#{unprotected.positive? ? 'text-danger' : 'text-muted'} hover:text-ink" do %>
        <span class="<%= unprotected.positive? ? 'text-danger font-semibold' : 'text-ink font-semibold' %>"><%= @stats[:apps_count] - unprotected %>/<%= @stats[:apps_count] %></span>
        backed up
      <% end %>
      <%= link_to credentials_path, class: "text-muted hover:text-ink" do %>
        <span class="text-ink font-semibold"><%= @stats[:credentials_active] %></span> credentials
      <% end %>
      <% if @recent_deployments.any? %>
        <span class="text-faint">last deploy <%= time_ago_in_words(@recent_deployments.first.created_at) %> ago</span>
      <% end %>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-10 space-y-10">

  <%# Issues Section - What needs attention %>
  <% if @issues.any? %>
    <div class="rounded-large border border-danger/30 bg-danger-tint p-6 shadow-soft">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-pill bg-danger/10 flex items-center justify-center">
            <svg class="h-5 w-5 text-danger" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <h2 class="font-display text-xl text-danger-deep">Active incidents</h2>
            <p class="text-sm text-danger"><%= pluralize(@issues.count, "incident") %> <%= @issues.one? ? "needs" : "need" %> an operator decision</p>
          </div>
        </div>
      </div>
      <div class="mt-4 space-y-2">
        <% @issues.first(5).each do |issue| %>
          <%# Some issues are about the FLEET, not one record (e.g. "3 apps have no backup"),
              so resource may be nil — one row with one action beats twelve criticals. %>
          <% resource_label = case issue[:type]
                              when "deployment"       then "#{issue[:resource].app.name} deployment"
                              when "backup"           then "#{issue[:resource].bucket_name} backup"
                              when "backup_coverage"  then "Backups"
                              when "capacity"         then issue[:resource].name
                              else issue[:resource]&.name
                              end %>
          <div class="flex items-center justify-between rounded-card bg-surface px-4 py-3 border <%= issue[:severity] == 'critical' ? 'border-danger/30' : issue[:severity] == 'warning' ? 'border-warning/40' : 'border-border' %>" data-incident-resource="<%= resource_label %>">
            <div class="flex items-center gap-3">
              <% if issue[:severity] == "critical" %>
                <span class="h-2 w-2 rounded-pill bg-danger-bright animate-pulse"></span>
              <% elsif issue[:severity] == "warning" %>
                <span class="h-2 w-2 rounded-pill bg-warning-bright"></span>
              <% else %>
                <span class="h-2 w-2 rounded-pill bg-faint"></span>
              <% end %>
              <div>
                <span class="text-sm font-medium text-ink">
                  <% if issue[:type] == "server" %>
                    <%= issue[:resource].name %>
                  <% elsif issue[:type] == "app" %>
                    <%= issue[:resource].name %>
                  <% elsif issue[:type] == "deployment" %>
                    <%= issue[:resource].app.name %> deployment
                  <% elsif issue[:type] == "backup" %>
                    <%= issue[:resource].bucket_name %> backup
                  <% elsif issue[:type] == "capacity" %>
              <%# Transfer has no UI yet — it's invocable over MCP (conductor_app action=transfer).
                  Link to the server rather than promise a screen that doesn't exist. %>
              <%= link_to "View", server_path(issue[:resource]), class: "text-2xs font-semibold uppercase tracking-label text-muted hover:text-ink" %>
            <% elsif issue[:type] == "backup_coverage" %>
                    Backups
                  <% elsif issue[:type] == "capacity" %>
                    Capacity
                  <% end %>
                </span>
                <span class="text-sm text-muted ml-2"><%= issue[:message] %></span>
              </div>
            </div>
            <% if issue[:type] == "app" && issue[:action] == "sync" %>
              <%= rui_button_to("Sync", sync_status_app_path(issue[:resource]), method: :post, variant: :ghost, size: :sm, color: :slate) %>
            <% elsif issue[:type] == "app" && issue[:action] == "logs" %>
              <%= rui_button("Logs", url: logs_app_path(issue[:resource]), variant: :ghost, size: :sm, color: :slate) %>
            <% elsif issue[:type] == "server" %>
              <%= link_to "View", server_path(issue[:resource]), class: "text-2xs font-semibold uppercase tracking-label text-muted hover:text-ink" %>
            <% elsif issue[:type] == "app" %>
              <%= link_to "View", app_path(issue[:resource]), class: "text-2xs font-semibold uppercase tracking-label text-muted hover:text-ink" %>
            <% elsif issue[:type] == "deployment" %>
              <%= link_to "View", deployment_path(issue[:resource]), class: "text-2xs font-semibold uppercase tracking-label text-muted hover:text-ink" %>
            <% elsif issue[:type] == "backup" %>
              <%= link_to "View", backup_path(issue[:resource]), class: "text-2xs font-semibold uppercase tracking-label text-muted hover:text-ink" %>
            <% elsif issue[:type] == "capacity" %>
              <%# Transfer has no UI yet — it's invocable over MCP (conductor_app action=transfer).
                  Link to the server rather than promise a screen that doesn't exist. %>
              <%= link_to "View", server_path(issue[:resource]), class: "text-2xs font-semibold uppercase tracking-label text-muted hover:text-ink" %>
            <% elsif issue[:type] == "backup_coverage" %>
              <%# The whole point of the design: the nag carries the fix. %>
              <%= rui_button_to("Protect all", protect_all_backups_path, method: :post, variant: :solid, size: :sm, color: :primary) %>
            <% end %>
          </div>
        <% end %>
        <% if @issues.count > 5 %>
          <p class="text-sm text-danger text-center pt-2">+ <%= @issues.count - 5 %> more issues</p>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-large border border-primary/30 bg-primary-tint p-6 shadow-soft">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-pill bg-primary/10 flex items-center justify-center">
          <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </div>
        <div>
          <h2 class="font-display text-xl text-primary">All Systems Operational</h2>
          <p class="text-sm text-primary-strong">No issues detected across your servers and apps</p>
        </div>
      </div>
    </div>
  <% end %>

  <%# Where it runs, then what's on it — capacity first, because the answer to "why is
      this app struggling" is usually the box, and the fleet list is long. %>
  <% if @apps.any? %>
    <%= render "dashboard/kamal_overview" %>
  <% end %>

  <%# The apps table lived here. It has been folded INTO Fleet status above: two tables
      answering overlapping questions is how a dashboard starts contradicting itself, and
      the fleet panel already had per-server grouping and the actions. %>

  <% if @servers.any? %>
    <div>
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-display text-xl text-ink">Server Fleet</h2>
          <p class="text-sm text-muted">Health and resource usage across hosts.</p>
        </div>
        <%= link_to "View all", servers_path, class: "text-2xs font-semibold uppercase tracking-label text-faint hover:text-muted" %>
      </div>
      <div class="mt-4 grid gap-4 lg:grid-cols-3">
        <% @servers.limit(3).each do |server| %>
          <%= render "dashboard/server_card", server: server %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <% if @backups.any? %>
      <div class="rounded-large border border-border bg-surface p-6 shadow-soft">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-display text-xl text-ink">Recent Backups</h2>
            <p class="text-sm text-muted">Latest backup activity.</p>
          </div>
          <%= link_to "View all", backups_path, class: "text-2xs font-semibold uppercase tracking-label text-faint hover:text-muted" %>
        </div>
        <div class="mt-4 space-y-3">
          <% @backups.limit(4).each do |backup| %>
            <div class="flex items-center justify-between rounded-card border border-border bg-bg-alt px-4 py-3">
              <div>
                <div class="text-sm font-semibold text-ink"><%= backup.bucket_name %></div>
                <div class="text-2xs text-muted">Retention <%= backup.retention_display %> · Size <%= backup.formatted_size %></div>
              </div>
              <div class="flex items-center gap-3">
                <div class="text-2xs text-muted"><%= backup.time_ago %></div>
                <span class="<%= status_badge(backup.status) %>"><%= backup.status %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @apps.any? %>
      <div class="rounded-large border border-border bg-surface p-6 shadow-soft">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-display text-xl text-ink">Deployed Apps</h2>
            <p class="text-sm text-muted">Rails applications across your fleet.</p>
          </div>
          <%= link_to "View all", apps_path, class: "text-2xs font-semibold uppercase tracking-label text-faint hover:text-muted" %>
        </div>
        <div class="mt-4 space-y-3">
          <% @apps.limit(4).each do |app| %>
            <div class="rounded-card border border-border bg-bg-alt px-4 py-3">
              <%= turbo_stream_from app %>
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-sm font-semibold text-ink"><%= app.name %></div>
                  <div class="text-2xs text-muted"><%= app.server_name %> · <%= app.domain || "No domain" %></div>
                </div>
                <%= render "apps/status_badge", app: app %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @servers.empty? && @backups.empty? && @apps.empty? %>
    <div class="rounded-large border border-dashed border-border-strong bg-fill p-12 text-center">
      <div class="font-display text-2xl text-ink">Get started with Conductor</div>
      <p class="mt-2 text-sm text-muted">Add your first server, app, or credential to begin monitoring.</p>
      <div class="mt-6 flex items-center justify-center gap-4">
        <%= link_to "Add Server", new_server_path, class: "inline-flex items-center rounded-control bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-strong" %>
        <%= link_to "Add App", new_app_path, class: "inline-flex items-center rounded-control border border-border bg-surface px-4 py-2 text-sm font-medium text-body hover:bg-fill" %>
      </div>
    </div>
  <% end %>
</section>
