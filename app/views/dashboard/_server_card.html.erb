<%# One server's live capacity. Broadcast whenever metrics land, so the fleet reflects the
    box rather than the last page load. dom_id must match Server#broadcast_dashboard_card.

    Bars rather than four numbers in boxes: a percentage tells you a value, a bar tells you
    how much room is left — which is the question. A box under real strain gets a warm
    border so the imbalance in a row of three cards is visible before you read anything. %>
<% strained = server.cpu_percent.to_i >= 60 %>
<div id="<%= dom_id(server, :dashboard_card) %>"
     class="rounded-large border bg-surface p-5 shadow-soft <%= strained ? 'border-danger/40' : 'border-border' %>">
  <div class="flex items-center justify-between gap-3">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 shrink-0 rounded-pill <%= strained ? 'bg-danger-bright' : 'bg-primary' %>"></span>
        <span class="text-sm font-semibold text-ink truncate"><%= server.name %></span>
      </div>
      <div class="mt-0.5 font-mono text-2xs text-faint">
        <%= server.ip_address %><%= " · #{server.edge_type}" if server.respond_to?(:edge_type) && server.edge_type.present? %>
      </div>
    </div>
    <span class="<%= status_badge(server.display_status) %>"><%= server.display_status %></span>
  </div>

  <% [
       [ "cpu", server.cpu_percent.to_i, "#{server.cpu_percent.to_i}%" ],
       [ "memory", server.memory_total_mb.to_i.positive? ? (server.memory_used_mb.to_i * 100 / server.memory_total_mb.to_i) : 0, server.formatted_memory ],
       [ "disk", server.disk_percent.to_i, "#{server.disk_percent.to_i}%" ]
     ].each do |label, pct, display| %>
    <div class="mt-3">
      <div class="flex items-baseline justify-between font-mono text-2xs text-muted">
        <span class="uppercase tracking-label"><%= label %></span>
        <span><%= display %></span>
      </div>
      <div class="mt-1 h-1.5 w-full overflow-hidden rounded-pill bg-fill">
        <%# Colour by pressure, not by metric: the eye should catch the one that's full. %>
        <div class="h-full rounded-pill <%= pct >= 80 ? 'bg-danger-bright' : pct >= 60 ? 'bg-warning-bright' : 'bg-primary-sage' %>"
             style="width: <%= [ [ pct, 0 ].max, 100 ].min %>%"></div>
      </div>
    </div>
  <% end %>

  <%# Which apps ride on this box — the other half of the imbalance story. A count alone
      doesn't tell you what you'd be moving. %>
  <% apps = server.apps.to_a %>
  <div class="mt-4 flex flex-wrap gap-1.5">
    <% if apps.any? %>
      <% apps.first(6).each do |app| %>
        <%= link_to app.slug, app_path(app),
              class: "rounded-card bg-fill px-2 py-1 font-mono text-2xs #{app.deploy_failing? ? 'text-danger-deep' : 'text-body'} hover:bg-fill-strong" %>
      <% end %>
      <% if apps.size > 6 %>
        <span class="rounded-card px-2 py-1 font-mono text-2xs text-faint">+<%= apps.size - 6 %></span>
      <% end %>
    <% else %>
      <span class="font-mono text-2xs text-faint">no apps</span>
    <% end %>
  </div>
</div>
