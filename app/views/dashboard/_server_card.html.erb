<%# One server's live capacity. Broadcast whenever metrics land, so the fleet reflects
    the box rather than the last page load. dom_id must match Server#broadcast_dashboard_card. %>
<div id="<%= dom_id(server, :dashboard_card) %>" class="rounded-large border border-border bg-surface p-5 shadow-soft">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm font-semibold text-ink"><%= server.name %></div>
              <div class="text-2xs text-muted"><%= server.region || server.provider || "—" %></div>
            </div>
            <span class="<%= status_badge(server.display_status) %>"><%= server.display_status %></span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-card bg-fill p-3">
              <div class="text-2xs uppercase tracking-label text-faint">CPU</div>
              <div class="mt-1 font-mono text-sm font-semibold text-ink"><%= server.cpu_display %></div>
            </div>
            <div class="rounded-card bg-fill p-3">
              <div class="text-2xs uppercase tracking-label text-faint">Memory</div>
              <div class="mt-1 font-mono text-sm font-semibold text-ink"><%= server.formatted_memory %></div>
            </div>
            <div class="rounded-card bg-fill p-3">
              <div class="text-2xs uppercase tracking-label text-faint">Disk</div>
              <div class="mt-1 font-mono text-sm font-semibold text-ink"><%= server.disk_display %></div>
            </div>
            <div class="rounded-card bg-fill p-3">
              <%# Apps-per-box next to CPU is what makes an imbalance visible: one app at
                  63% on 2 cores beside six apps at 3% on 64GB is invisible unless both
                  numbers sit together. %>
              <div class="text-2xs uppercase tracking-label text-faint">Apps</div>
              <div class="mt-1 font-mono text-sm font-semibold text-ink"><%= server.apps.size %></div>
            </div>
          </div>
        </div>
