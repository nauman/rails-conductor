<% content_for :title, "#{@backup.bucket_name} · Conductor" %>

<%# One backup. Trust leads: "completed" only says the dump was written, and an untested
    dump is a promise. verification_state is the honest answer and it heads the page. %>
<% state = @backup.verification_state %>
<% trust = case state
           when :verified       then [ "Proved by a restore", :default ]
           when :restore_failed then [ "Restore FAILED", :danger ]
           when :stale          then [ "Behind schedule", :warning ]
           when :never_run      then [ "Never run", :warning ]
           else [ "Never restore-tested", :warning ]
           end %>
<%= render layout: "shared/page_head",
      locals: {
        eyebrow: "#{@backup.provider.titleize.gsub("_", " ")} · #{@backup.source_name}",
        title: case state
               when :verified       then "#{@backup.bucket_name} restores."
               when :restore_failed then "#{@backup.bucket_name} does not restore."
               when :stale          then "#{@backup.bucket_name} has stopped running."
               when :never_run      then "#{@backup.bucket_name} has never run."
               else "#{@backup.bucket_name} is untested."
               end,
        lede: state == :unverified ? "The dump is being written. Nobody has restored it, so we don't yet know it works." : nil,
        stats: [
          { value: trust[0], label: "trust", tone: trust[1] },
          { value: @backup.status, label: "last result", tone: @backup.status == "failed" ? :danger : :default },
          { value: @backup.formatted_size, label: "size" },
          { value: @backup.retention_display, label: "retention" },
          { value: @backup.time_ago, label: "last run" },
          { value: @backup.enabled? ? @backup.schedule_display : "manual", label: "schedule" }
        ]
      } do %>
  <% if @backup.credential.present? %>
    <%= rui_button_to("Run now", run_backup_path(@backup), method: :post, variant: :solid, color: :primary) %>
  <% end %>
  <%= rui_button("Edit", url: edit_backup_path(@backup), variant: :outline, color: :slate) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8 space-y-5">
  <% if state == :restore_failed %>
    <%= rui_alert(type: :danger) do %>
      <span class="font-medium">The last restore test failed.</span>
      This dump exists and does not work — treat this database as unprotected until a restore
      succeeds.
    <% end %>
  <% elsif state == :stale %>
    <%= rui_alert(type: :warning) do %>
      <span class="font-medium">This backup is behind its own schedule.</span>
      The newest data isn't in any dump. Measured from the last run, not from the next-run
      field, so a stalled scheduler can't hide.
    <% end %>
  <% end %>

  <div class="grid gap-5 lg:grid-cols-2 lg:items-start">
    <%= render layout: "shared/panel", locals: { title: "Destination" } do %>
      <dl class="space-y-3 text-sm">
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Bucket</dt>
          <dd class="mt-0.5 font-mono text-xs text-ink"><%= @backup.bucket_name %></dd>
        </div>
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Provider</dt>
          <dd class="mt-0.5 text-ink"><%= @backup.provider.titleize.gsub("_", " ") %></dd>
        </div>
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Credential</dt>
          <dd class="mt-0.5 text-ink">
            <% if @backup.credential %>
              <%= @backup.credential.name %> <span class="font-mono text-2xs text-faint">(<%= @backup.credential.provider %>)</span>
            <% else %>
              <span class="text-warning-deep">none — this backup cannot run</span>
            <% end %>
          </dd>
        </div>
      </dl>
    <% end %>

    <%= render layout: "shared/panel", locals: { title: "Source" } do %>
      <dl class="space-y-3 text-sm">
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Server</dt>
          <dd class="mt-0.5 text-ink">
            <%= @backup.server ? link_to(@backup.server.name, server_path(@backup.server), class: "hover:underline") : "—" %>
          </dd>
        </div>
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">App</dt>
          <dd class="mt-0.5 text-ink">
            <%= @backup.app ? link_to(@backup.app.name, app_path(@backup.app), class: "hover:underline") : "—" %>
          </dd>
        </div>
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Next run</dt>
          <dd class="mt-0.5 font-mono text-xs text-ink"><%= @backup.next_run_display %></dd>
        </div>
        <div>
          <dt class="font-mono text-2xs uppercase tracking-label text-muted">Last completed</dt>
          <dd class="mt-0.5 font-mono text-xs text-ink"><%= @backup.completed_at&.strftime("%Y-%m-%d %H:%M UTC") || "—" %></dd>
        </div>
      </dl>
    <% end %>
  </div>

  <div class="rounded-large border border-border bg-surface px-5 py-4 shadow-soft">
    <%= rui_button_to("Delete backup", backup_path(@backup), method: :delete, variant: :link, color: :danger, size: :sm,
          data: { turbo_confirm: "Delete this backup configuration? Dumps already in the bucket are left alone." }) %>
  </div>
</section>
