<%= form_with model: backup, class: "space-y-6" do |f| %>
  <% if backup.errors.any? %>
    <div class="rounded-card border border-danger/30 bg-danger-tint p-4">
      <div class="text-sm font-medium text-danger-deep">Please fix the following errors:</div>
      <ul class="mt-2 list-disc list-inside text-sm text-danger-deep">
        <% backup.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-large border border-border bg-surface p-6 shadow-soft space-y-6">
    <h2 class="text-sm font-semibold text-ink">Backup Source</h2>
    <p class="text-xs text-muted -mt-4">Choose what to backup - a server's database or an app's database.</p>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= f.label :server_id, "Server", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.collection_select :server_id, @servers, :id, :name, { include_blank: "Select server (optional)" }, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
      </div>

      <div>
        <%= f.label :app_id, "App", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.collection_select :app_id, @apps, :id, :name, { include_blank: "Select app (optional)" }, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
      </div>
    </div>
  </div>

  <div class="rounded-large border border-border bg-surface p-6 shadow-soft space-y-6">
    <h2 class="text-sm font-semibold text-ink">Storage Destination</h2>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= f.label :provider, class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.select :provider, BackupVendors.all.map { |v| [v.label, v.key] }, {}, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
      </div>

      <div>
        <%= f.label :credential_id, "Credential", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <% if @credentials.any? %>
          <%= f.collection_select :credential_id, @credentials, :id, :name, { include_blank: "Select credential" }, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
        <% else %>
          <div class="mt-1 text-sm text-muted">
            No credentials available. <%= link_to "Add one first", new_credential_path, class: "text-ink hover:underline" %>.
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= f.label :bucket_name, class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.text_field :bucket_name, class: "mt-1 block w-full rounded-control border-border-strong font-mono text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "my-backups-bucket" %>
        <p class="mt-1 text-2xs text-muted">
          Must already exist in R2 — a backup to a missing bucket fails.
          <%= button_to "Create it in R2", create_bucket_backups_path,
                params: { bucket_name: f.object.bucket_name },
                form: { data: { turbo_confirm: "Create this R2 bucket in the connected Cloudflare account?" } },
                class: "underline hover:no-underline" %>
        </p>
      </div>

      <div>
        <%= f.label :retention_days, "Retention (days)", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.number_field :retention_days, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", min: 1, max: 365, value: backup.retention_days || 7 %>
      </div>
    </div>

    <div>
      <%= f.label :env_file, "Env file to source (host apps only)", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
      <%= f.text_field :env_file, placeholder: "/home/deploy/myapp/.asdf-vars", class: "mt-1 block w-full rounded-control border-border-strong font-mono text-sm shadow-soft focus:border-primary focus:ring-primary" %>
      <p class="mt-1 text-xs text-muted">
        Leave blank for containerised apps — Conductor finds the database itself.
        Set this only when the app runs on the host (systemd/puma) and its
        <code class="font-mono">DATABASE_URL</code> lives in a per-app env file. Without it there is no
        <code class="font-mono">DATABASE_URL</code> in the SSH session and the dump has nothing to connect to.
      </p>
    </div>
  </div>

  <div class="rounded-large border border-border bg-surface p-6 shadow-soft space-y-6">
    <h2 class="text-sm font-semibold text-ink">Schedule</h2>

    <div class="flex items-center gap-3">
      <%= f.check_box :enabled, class: "rounded border-border-strong text-ink focus:ring-primary" %>
      <%= f.label :enabled, "Enable automatic backups", class: "text-sm text-body" %>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= f.label :schedule, "Frequency", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.select :schedule, Backup::SCHEDULES.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
      </div>

      <% if backup.persisted? && backup.next_run_at %>
        <div>
          <div class="block text-sm font-medium text-body">Next Run</div>
          <div class="mt-1 text-sm text-body"><%= backup.next_run_at&.strftime("%b %d, %Y at %H:%M") || "Not scheduled" %></div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-4">
    <%= link_to "Cancel", backups_path, class: "text-sm font-medium text-body hover:text-ink" %>
    <%= f.submit backup.persisted? ? "Update Backup" : "Create Backup", class: "inline-flex items-center rounded-control bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-body cursor-pointer" %>
  </div>
<% end %>
