<% content_for :title, "Deployment ##{@deployment.id} · #{@app.name} · Conductor" %>
<%= turbo_stream_from @deployment %>

<%# One deploy. The header answers "did it work, how long, who asked for it" — the four
    boxes underneath used to repeat the status badge twice and print two clock times. %>
<%= render layout: "shared/page_head",
      locals: {
        eyebrow: @app.name,
        title: case @deployment.status
               when "succeeded" then "Deploy succeeded."
               when "failed"    then "Deploy failed."
               when "blocked"   then "Deploy blocked before it started."
               else "Deploy #{@deployment.status}…"
               end,
        lede: activity_reason(@deployment),
        stats: [
          # The cause comes from THIS deployment, not from the app's latest: an old failure
          # must not be labelled with today's cause.
          { value: @deployment.status, label: @deployment.cause_class.presence&.humanize&.downcase || "status",
            tone: %w[failed blocked].include?(@deployment.status) ? :danger : :default },
          { value: @deployment.formatted_duration, label: "duration" },
          { value: @deployment.commit_sha&.first(7) || "—", label: "commit" },
          { value: @deployment.created_at.strftime("%b %d, %H:%M"), label: "started" },
          { value: @deployment.user&.email || "automation", label: "triggered by" }
        ]
      } do %>
  <% if @deployment.in_progress? %>
    <%= rui_badge(text: "In progress", color: :warning, size: :lg) %>
  <% end %>
  <%= rui_button("Back to app", url: app_path(@app), variant: :outline, color: :slate) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8">
  <%# The log is the page. Dark surface because it is terminal output, not UI chrome. %>
  <div class="rounded-large border border-border-strong bg-ink shadow-soft overflow-hidden">
    <div class="p-4 border-b border-border-strong flex items-center justify-between">
      <h2 class="font-mono text-2xs uppercase tracking-label text-white/70">Deploy log</h2>
      <% if @deployment.in_progress? %>
        <span id="deploy-live-indicator" class="text-xs text-faint">Live streaming...</span>
      <% end %>
    </div>
    <div id="deploy-log-container" class="p-4 max-h-[600px] overflow-y-auto">
      <pre id="deploy-log" class="text-sm text-faint font-mono whitespace-pre-wrap"><%= @deployment.log %></pre>
    </div>
  </div>

  <%# Tail the log: jump to the latest line on load so you don't scroll a long log. %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var c = document.getElementById("deploy-log-container");
      if (c) c.scrollTop = c.scrollHeight;
    });
  </script>

  <% if @deployment.in_progress? %>
    <script>
    (function() {
      const logEl = document.getElementById("deploy-log");
      const container = document.getElementById("deploy-log-container");
      const indicator = document.getElementById("deploy-live-indicator");

      const consumer = ActionCable.createConsumer();
      const sub = consumer.subscriptions.create(
        { channel: "DeployChannel", deployment_id: <%= @deployment.id %> },
        {
          received(data) {
            if (data.type === "log") {
              logEl.textContent += data.line;
              container.scrollTop = container.scrollHeight;
            }

            if (data.type === "status" && (data.status === "succeeded" || data.status === "failed")) {
              if (indicator) indicator.textContent = "Completed";
              sub.unsubscribe();
              setTimeout(function() { window.location.reload(); }, 1000);
            }
          },

          disconnected() {
            if (indicator) indicator.textContent = "Disconnected — refreshing...";
            setTimeout(function() { window.location.reload(); }, 3000);
          }
        }
      );
    })();
    </script>
  <% end %>
</section>
