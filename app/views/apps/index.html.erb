<% content_for :title, "Apps · Conductor" %>

<%# The same table as the dashboard's fleet panel, with the full list rather than a peek.
    Cards gave every app equal weight and buried the one that's broken behind port and
    slug; a row you can scan puts runtime and deploy state under the same eye. %>
<% failing = @apps.count(&:deploy_failing?) %>
<% unprotected = @apps.count { |a| a.naggable? && a.backups.empty? } %>
<%= render layout: "shared/page_head",
      locals: {
        title: failing.positive? ? "#{pluralize(failing, "app")} #{failing == 1 ? "needs" : "need"} a look." : "#{pluralize(@apps.size, "app")}, all shipping.",
        stats: [
          { value: @apps.size, label: "total" },
          ({ value: failing, label: "failing", tone: :danger } if failing.positive?),
          { value: @apps.map(&:server_id).uniq.size, label: "servers", url: servers_path },
          ({ value: unprotected, label: "unprotected", tone: :danger, url: backups_path } if unprotected.positive?)
        ].compact
      } do %>
  <%= rui_button_to("Put fleet behind Cloudflare", put_all_behind_cloudflare_apps_path, method: :post,
        variant: :outline, size: :md, color: :primary,
        data: { turbo_confirm: "Proxy every app's domain through Cloudflare (SSL: Full)? Speeds up far-away visitors." }) %>
  <%= rui_button("New app", url: new_app_path, color: :primary, size: :md) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8">
  <% if @apps.any? %>
    <%= render layout: "shared/panel",
          locals: { title: "All apps", flush: true,
                    meta: "#{@apps.size} total#{" · #{failing} failing now" if failing.positive?}" } do %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="bg-fill font-mono text-2xs uppercase tracking-label text-muted">
              <th class="px-5 py-2 text-left font-semibold">App</th>
              <th class="px-5 py-2 text-left font-semibold">Server</th>
              <th class="px-5 py-2 text-left font-semibold">Runtime</th>
              <th class="px-5 py-2 text-left font-semibold">Last deploy</th>
              <th class="px-5 py-2 text-left font-semibold">Release</th>
              <th class="px-5 py-2 text-right font-semibold"></th>
            </tr>
          </thead>
          <tbody>
            <% @apps.each do |app| %>
              <%= turbo_stream_from app %>
              <%= render "dashboard/app_row", app: app %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-large border border-dashed border-border-strong bg-fill p-12 text-center">
      <h2 class="font-display text-xl text-ink">No apps yet</h2>
      <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
        Point Conductor at a repository and a server, and it deploys, routes and backs the
        app up from there.
      </p>
      <%= rui_button "Add your first app", url: new_app_path, color: :primary, class: "mt-5" %>
    </div>
  <% end %>
</section>
