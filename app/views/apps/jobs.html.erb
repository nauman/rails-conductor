<% content_for :title, "Jobs · #{@app.name} · Conductor" %>

<%# Background jobs (design: conductor/design/jobs.html).
    The old page showed four counters and a workers table — so "14 failed" was a number
    with nothing to click, and "5 pending, 0 workers alive" read as calm. Both are now
    stated as conditions, with the failing jobs named. %>
<% stalled = @stats.available && @stats.stalled? %>
<%= render layout: "shared/page_head",
      locals: {
        eyebrow: @app.name,
        title: if !@stats.available
                 "Queue state unknown."
               elsif stalled
                 "#{pluralize(@stats.pending, "job")} queued, nothing running them."
               elsif @stats.failed.positive?
                 "#{pluralize(@stats.failed, "job")} failed."
               elsif !@stats.all_workers_alive?
                 "#{@stats.workers_total - @stats.workers_alive} of #{@stats.workers_total} workers stopped beating."
               else
                 "Queue is keeping up."
               end,
        lede: "Solid Queue, read straight from this app's queue database.",
        stats: (@stats.available ? [
          { value: @stats.pending, label: "pending", tone: stalled ? :danger : :default },
          { value: @stats.running, label: "running" },
          { value: @stats.scheduled, label: "scheduled" },
          { value: @stats.failed, label: "failed", tone: @stats.failed.positive? ? :danger : :default },
          { value: "#{@stats.workers_alive}/#{@stats.workers_total}", label: "workers alive",
            tone: @stats.all_workers_alive? ? :default : :danger },
          ({ value: time_ago_in_words(@stats.oldest_pending_at), label: "oldest wait",
             tone: @stats.oldest_pending_at < 15.minutes.ago ? :warning : :default } if @stats.oldest_pending_at)
        ].compact : [])
      } do %>
  <% if @app.url.present? %>
    <%= rui_button("Mission Control ↗", url: "#{@app.url}/jobs", variant: :outline, color: :slate,
          target: "_blank", rel: "noopener") %>
  <% end %>
  <%= rui_button("Re-read", url: jobs_app_path(@app), variant: :outline, color: :slate) %>
  <%= rui_button("Back to app", url: app_path(@app), variant: :outline, color: :slate) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8 space-y-5">
  <% unless @stats.available %>
    <%= render layout: "shared/panel", locals: { title: "No queue data", tone: :warning } do %>
      <p class="text-sm text-muted">
        Conductor couldn't read this app's queue database, so nothing here is a claim about
        whether jobs are running.
      </p>
      <p class="mt-2 font-mono text-2xs text-faint"><%= @stats.error %></p>
      <p class="mt-3 text-2xs text-muted">
        Either the app doesn't use Solid Queue, or its <code>QUEUE_DATABASE_URL</code> /
        <code>DATABASE_URL</code> isn't reachable from here.
      </p>
    <% end %>
  <% end %>

  <% if @stats.available %>
    <% if stalled %>
      <%= rui_alert(type: :danger) do %>
        <span class="font-medium">Jobs are queued and no worker is alive to run them.</span>
        These jobs haven't failed — they will simply never run. Start the Solid Queue
        supervisor (<code class="font-mono">SOLID_QUEUE_IN_PUMA=1</code>, or a separate
        worker process) and the backlog drains on its own.
      <% end %>
    <% end %>

    <% if @stats.failures.any? %>
      <%# Grouped: the same job failing 14 times is one problem, not fourteen. %>
      <%= render layout: "shared/panel",
            locals: { title: "What's failing", flush: true, tone: :danger,
                      meta: "#{pluralize(@stats.failed, "failed execution")} · #{pluralize(@stats.failures_by_job.size, "distinct cause")}" } do %>
        <div class="divide-y divide-border">
          <% @stats.failures_by_job.each do |failure| %>
            <div class="px-5 py-3" data-job-failure="<%= failure[:job_class] %>">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-mono text-sm font-medium text-ink"><%= failure[:job_class] %></span>
                <span class="font-mono text-2xs text-faint">
                  <%= pluralize(failure[:count], "time") %><%= " · #{failure[:queue]} queue" if failure[:queue].present? %><%= " · last #{time_ago_in_words(failure[:failed_at])} ago" if failure[:failed_at] %>
                </span>
              </div>
              <% if failure[:error].present? %>
                <p class="mt-1 break-words font-mono text-2xs text-danger-deep"><%= failure[:error] %></p>
              <% end %>
            </div>
          <% end %>
        </div>
        <% if @stats.failed > @stats.failures.size %>
          <div class="border-t border-border px-5 py-2 font-mono text-2xs text-faint">
            showing the <%= @stats.failures.size %> most recent of <%= @stats.failed %>
          </div>
        <% end %>
        <div class="border-t border-border bg-bg-alt px-5 py-3 text-2xs text-muted">
          Backtraces and retries live in the app's own Mission Control — Conductor reads the
          queue, it doesn't run it.
          <% if @app.url.present? %>
            <%= link_to "Open Mission Control ↗", "#{@app.url}/jobs", target: "_blank", rel: "noopener", class: "font-medium text-primary hover:underline" %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= render layout: "shared/panel",
          locals: { title: "Workers", flush: true,
                    tone: @stats.all_workers_alive? ? :default : :danger,
                    meta: @stats.workers.any? ? "#{@stats.workers_alive} of #{@stats.workers_total} beating within 5 minutes" : "none registered" } do %>
      <% if @stats.workers.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="bg-fill font-mono text-2xs uppercase tracking-label text-muted">
                <th class="px-5 py-2 text-left font-semibold">Process</th>
                <th class="px-5 py-2 text-left font-semibold">Kind</th>
                <th class="px-5 py-2 text-left font-semibold">Last heartbeat</th>
                <th class="px-5 py-2 text-left font-semibold">State</th>
              </tr>
            </thead>
            <tbody>
              <% @stats.workers.each do |w| %>
                <tr class="border-t border-border">
                  <td class="px-5 py-2 font-mono text-2xs text-body"><%= w[:name] %></td>
                  <td class="px-5 py-2 font-mono text-2xs text-muted"><%= w[:kind] %></td>
                  <td class="px-5 py-2 font-mono text-2xs text-muted"><%= w[:last_heartbeat_at] ? "#{time_ago_in_words(w[:last_heartbeat_at])} ago" : "—" %></td>
                  <td class="px-5 py-2">
                    <%= rui_badge(text: w[:alive] ? "alive" : "stale", color: w[:alive] ? :success : :danger, size: :sm) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="px-5 py-6 text-sm text-danger-deep">
          No worker process is registered, so background jobs are <strong>not being
          processed</strong> — including mailers and anything deferred. Check that the Solid
          Queue supervisor is running.
        </p>
      <% end %>
    <% end %>
  <% end %>
</section>
