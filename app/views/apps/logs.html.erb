<% content_for :title, "Logs · #{@app.name} · Conductor" %>

<%# Container logs. The header states where the lines come from, because "Container Logs"
    over a native systemd service was quietly wrong. %>
<%= render layout: "shared/page_head",
      locals: {
        eyebrow: @app.name,
        title: "Live output from #{@app.log_source_label}.",
        lede: "Last #{@tail} lines, re-read on a timer. Conductor tails the box — it doesn't store your logs.",
        stats: [
          { value: @app.container_status.presence || "unknown", label: "runtime",
            tone: @app.container_running? ? :default : :danger },
          { value: @tail, label: "lines" },
          { value: @app.server&.name || "—", label: "server", url: (server_path(@app.server) if @app.server) }
        ]
      } do %>
  <label class="inline-flex cursor-pointer items-center gap-2 rounded-control border border-border-strong bg-surface px-3 py-2 text-sm font-medium text-body hover:bg-fill">
    <input type="checkbox" id="auto-refresh" checked class="rounded border-border-strong text-ink focus:ring-primary">
    <span>Live tail</span>
  </label>
  <%= rui_button("Re-read", url: logs_app_path(@app), id: "manual-refresh", variant: :outline, color: :slate) %>
  <%= rui_button("Back to app", url: app_path(@app), variant: :outline, color: :slate) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8">
  <%# How to tail it yourself, for when you need more than this page gives. %>
  <details class="mb-4 text-2xs text-muted">
    <summary class="cursor-pointer font-mono uppercase tracking-label hover:text-body">Tail it on the box</summary>
    <% if @app.native? %>
      <pre class="mt-2 font-mono text-2xs bg-ink text-faint rounded-card px-3 py-2 overflow-x-auto whitespace-pre-wrap">ssh <%= @app.server&.ssh_user %>@<%= @app.server&.ip_address %>
journalctl --user -u <%= @app.service_name %> -n <%= @tail %> -f</pre>
    <% elsif @app.kamal? %>
      <pre class="mt-2 font-mono text-2xs bg-ink text-faint rounded-card px-3 py-2 overflow-x-auto whitespace-pre-wrap">ssh <%= @app.server&.ssh_user %>@<%= @app.server&.ip_address %>
# Kamal names the container <service>-<role>-<version> — resolve it by the service label:
docker logs -f --tail <%= @tail %> $(docker ps -q -f label=service=<%= @app.kamal_service %> | head -1)
# or from the app repo: kamal app logs -f</pre>
    <% else %>
      <pre class="mt-2 font-mono text-2xs bg-ink text-faint rounded-card px-3 py-2 overflow-x-auto whitespace-pre-wrap">ssh <%= @app.server&.ssh_user %>@<%= @app.server&.ip_address %>
docker logs -f --tail <%= @tail %> <%= @app.container_name %></pre>
    <% end %>
  </details>

  <div class="mt-8 rounded-large border border-border-strong bg-ink shadow-soft overflow-hidden" id="log-container">
    <div class="p-4 border-b border-border-strong flex items-center justify-between">
      <div class="flex items-center gap-3">
        <h2 class="font-mono text-2xs uppercase tracking-label text-white/70"><%= @app.log_source_label %></h2>
        <span id="refresh-indicator" class="hidden">
          <svg class="h-4 w-4 text-faint animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
      </div>
      <div class="flex items-center gap-3">
        <span id="last-updated" class="text-xs text-faint">Updated just now</span>
        <%= rui_badge(text: @app.container_status || "unknown", color: @app.container_running? ? :success : :slate, size: :sm) %>
      </div>
    </div>
    <div class="p-4 max-h-[700px] overflow-y-auto" id="log-content">
      <% if @logs.present? %>
        <pre class="text-sm text-faint font-mono whitespace-pre-wrap"><%= @logs %></pre>
      <% else %>
        <p class="text-sm text-muted">No logs available.</p>
      <% end %>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const checkbox = document.getElementById('auto-refresh');
    const logContent = document.getElementById('log-content');
    const refreshIndicator = document.getElementById('refresh-indicator');
    const lastUpdated = document.getElementById('last-updated');
    let intervalId = null;

    function fetchLogs() {
      refreshIndicator.classList.remove('hidden');

      fetch('<%= logs_app_path(@app, format: :json) %>')
        .then(response => response.json())
        .then(data => {
          if (data.logs) {
            logContent.innerHTML = '<pre class="text-sm text-faint font-mono whitespace-pre-wrap">' + escapeHtml(data.logs) + '</pre>';
          } else {
            logContent.innerHTML = '<p class="text-sm text-muted">No logs available.</p>';
          }
          lastUpdated.textContent = 'Updated just now';
          refreshIndicator.classList.add('hidden');

          // Auto-scroll to bottom
          logContent.scrollTop = logContent.scrollHeight;
        })
        .catch(error => {
          console.error('Error fetching logs:', error);
          refreshIndicator.classList.add('hidden');
        });
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    checkbox.addEventListener('change', function() {
      if (this.checked) {
        fetchLogs();
        intervalId = setInterval(fetchLogs, 3000);
      } else {
        if (intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
      }
    });

    // Live tail is on by default — start immediately.
    if (checkbox.checked) {
      fetchLogs();
      intervalId = setInterval(fetchLogs, 2500);
    }

    // Update "last updated" text periodically
    setInterval(function() {
      const current = lastUpdated.textContent;
      if (current === 'Updated just now') {
        lastUpdated.textContent = 'Updated a few seconds ago';
      }
    }, 10000);
  });
</script>
