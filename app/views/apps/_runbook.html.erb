<%# Per-app deploy runbook + checklist. Each app deploys differently; this is the
    human-facing mirror of the conductor_runbook MCP tool. %>
<div id="runbook" class="mt-8 rounded-large border border-border dark:border-border bg-surface dark:bg-body shadow-soft overflow-hidden">
  <div class="p-4 border-b border-border dark:border-border bg-fill dark:bg-fill flex items-center justify-between">
    <h3 class="text-sm font-semibold text-ink dark:text-white">Deploy runbook &amp; checklist</h3>
    <% resolved = AppRunbook.new(app).resolve %>
    <% done = resolved.progress[:done] %>
    <%= rui_badge(text: "#{done}/#{resolved.progress[:total]} done", color: done == resolved.progress[:total] && resolved.progress[:total].positive? ? :success : :slate, size: :sm) %>
  </div>

  <%# Runbook (markdown source, shown verbatim) %>
  <div class="p-4 border-b border-border dark:border-border">
    <%= form_with url: update_runbook_app_path(app), method: :patch do |f| %>
      <label class="block text-xs font-medium text-body dark:text-faint mb-1">Runbook (markdown) — read before deploying</label>
      <%= f.text_area "app[deploy_runbook]", value: resolved.description, rows: resolved.description.present? ? 8 : 3,
            class: "block w-full rounded-control border-border-strong dark:border-border-strong dark:bg-fill dark:text-white shadow-soft focus:border-primary focus:ring-primary text-sm font-mono",
            placeholder: "## Deploy steps\n1. Boot the db accessory\n2. Restore prod DB\n3. kamal deploy" %>
      <%= hidden_field_tag "app[expected_revision]", resolved.revision %>
      <div class="mt-2 text-right"><%= f.rui_button("Save runbook", color: :primary, size: :sm) %></div>
    <% end %>
  </div>

  <%# Checklist %>
  <div class="p-4">
    <% if resolved.checklist.any? %>
      <ul class="divide-y divide-border dark:divide-border mb-3">
        <% resolved.checklist.each do |item| %>
          <li class="flex items-center gap-3 py-2">
            <%= form_with url: app_deploy_checklist_item_path(app, item[:id]), method: :patch, scope: :deploy_checklist_item, class: "flex items-center" do |f| %>
              <%= f.hidden_field :done, value: false %>
              <%= f.hidden_field :expected_revision, value: resolved.revision %>
              <%= f.check_box :done, checked: item[:done], onchange: "this.form.requestSubmit()",
                    class: "rounded border-border-strong dark:border-border-strong text-ink focus:ring-primary" %>
            <% end %>
            <span class="flex-1 text-sm <%= item[:done] ? 'line-through text-faint dark:text-muted' : 'text-ink dark:text-white' %>">
              <%= item[:text] %>
              <% unless item[:required] %><span class="text-xs text-muted">(optional)</span><% end %>
            </span>
            <%= rui_button_to("Remove", app_deploy_checklist_item_path(app, item[:id], expected_revision: resolved.revision), method: :delete, variant: :link, color: :danger, size: :sm) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-muted dark:text-faint mb-3">No checklist steps yet.</p>
    <% end %>

    <%= form_with url: app_deploy_checklist_items_path(app), method: :post, scope: :deploy_checklist_item, class: "flex items-end gap-3" do |f| %>
      <div class="flex-1">
        <label class="block text-xs font-medium text-body dark:text-faint mb-1">Add a step</label>
        <%= f.text_field :content, class: "block w-full rounded-control border-border-strong dark:border-border-strong dark:bg-fill dark:text-white shadow-soft focus:border-primary focus:ring-primary text-sm", placeholder: "Restore prod DB into the staging cluster" %>
      </div>
      <%= f.hidden_field :expected_revision, value: resolved.revision %>
      <%= f.rui_button("Add", color: :primary, size: :sm) %>
    <% end %>
  </div>
</div>
