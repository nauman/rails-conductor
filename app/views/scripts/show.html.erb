<% content_for :title, @script.name %>

<%= render layout: "shared/page_head",
      locals: {
        eyebrow: @script.built_in? ? "built-in script" : "your script",
        title: @script.name,
        lede: @script.description.presence,
        stats: [ { value: @script.script_type, label: "type" } ]
      } do %>
  <%= rui_button("Edit", url: edit_script_path(@script), variant: :outline, color: :slate) %>
  <%= rui_button("All scripts", url: scripts_path, variant: :outline, color: :slate) %>
<% end %>

<div class="max-w-5xl mx-auto px-4 py-8">

  <% if @script.description.present? %>
    <p class="text-body mb-6"><%= @script.description %></p>
  <% end %>

  <div class="bg-ink rounded-card overflow-hidden shadow-lg mb-6">
    <div class="px-4 py-2 bg-ink border-b border-white/10">
      <span class="text-xs text-muted font-mono"><%= @script.name %>.sh</span>
    </div>
    <pre class="text-primary-sage font-mono text-xs p-4 overflow-auto max-h-[500px] whitespace-pre-wrap"><%= @script.body %></pre>
  </div>

  <% if @servers.any? %>
    <div class="bg-surface rounded-card border border-border p-5">
      <h2 class="text-sm font-semibold text-body uppercase tracking-wider mb-4">Run on a Server</h2>
      <%= form_with url: '#', method: :post, id: "run-form" do %>
        <div class="flex items-end gap-3">
          <div class="flex-1">
            <label class="text-sm text-body block mb-1">Target Server</label>
            <select id="server-select" class="w-full text-sm border border-border-strong rounded-md px-3 py-2">
              <% @servers.each do |server| %>
                <option value="<%= server.id %>" data-url="<%= provision_server_path(server) %>">
                  <%= server.name %> (<%= server.ip_address %>)
                </option>
              <% end %>
            </select>
          </div>
          <button type="submit" class="px-4 py-2 text-sm font-medium rounded-md bg-ink hover:bg-body text-white cursor-pointer">
            Run Script
          </button>
        </div>
      <% end %>
      <script>
        document.getElementById('run-form').addEventListener('submit', function(e) {
          e.preventDefault();
          const sel = document.getElementById('server-select');
          const url = sel.selectedOptions[0].dataset.url;
          if (confirm('Run on ' + sel.selectedOptions[0].text + '?')) {
            const f = document.createElement('form');
            f.method = 'POST'; f.action = url;
            const csrf = document.querySelector('meta[name="csrf-token"]').content;
            f.innerHTML = '<input type="hidden" name="authenticity_token" value="' + csrf + '"><input type="hidden" name="script_id" value="<%= @script.id %>">';
            document.body.appendChild(f);
            f.submit();
          }
        });
      </script>
    </div>
  <% end %>
</div>
