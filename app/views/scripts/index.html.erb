<% content_for :title, "Provisioning Scripts" %>

<%= render layout: "shared/page_head",
      locals: {
        title: "#{pluralize(@scripts.size, "script")} you can run on a box.",
        lede: "Shell run over SSH as the server's Conductor user. Built-ins ship with Conductor; your own are versioned here and scheduled from a server's page.",
        stats: [
          { value: @scripts.size, label: "scripts" },
          { value: @scripts.count(&:built_in?), label: "built-in" }
        ]
      } do %>
  <%= rui_button("New script", url: new_script_path, color: :primary, size: :md) %>
<% end %>

<div class="max-w-5xl mx-auto px-4 py-8">

  <% Script::TYPES.each do |type| %>
    <% group = @scripts.select { |s| s.script_type == type } %>
    <% next if group.empty? %>
    <div class="mb-6">
      <h2 class="font-mono text-2xs uppercase tracking-label text-muted mb-3"><%= type %></h2>
      <div class="bg-surface rounded-card border border-border divide-y divide-border">
        <% group.each do |script| %>
          <div class="flex items-center justify-between px-5 py-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-medium text-ink"><%= script.name %></span>
                <% if script.built_in? %>
                  <span class="text-xs px-1.5 py-0.5 rounded bg-fill-strong text-muted">built-in</span>
                <% end %>
              </div>
              <p class="text-xs text-muted mt-0.5"><%= script.description %></p>
            </div>
            <div class="flex items-center gap-3">
              <%= link_to "View", script_path(script), class: "text-sm text-muted hover:text-body" %>
              <%= link_to "Edit", edit_script_path(script), class: "text-sm text-muted hover:text-body" %>
              <%= button_to "Delete", script_path(script), method: :delete, data: { turbo_confirm: "Delete #{script.name}?" }, class: "text-sm text-danger-tint0 bg-transparent cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @scripts.empty? %>
    <div class="text-center py-16 bg-surface rounded-card border border-border">
      <p class="text-muted mb-3">No scripts yet.</p>
      <%= link_to "Create your first script", new_script_path, class: "text-primary hover:underline text-sm" %>
    </div>
  <% end %>
</div>
