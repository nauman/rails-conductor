<%
  # Small inline icon set (stroke, currentColor) so cards carry a real glyph.
  icon_paths = {
    command:     '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M7 9.5l3 2.5-3 2.5"/><path d="M12.5 14.5h4.5"/>',
    lock:        '<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/>',
    server:      '<rect x="4" y="4.5" width="16" height="6" rx="1.5"/><rect x="4" y="13" width="16" height="6" rx="1.5"/><path d="M7.5 7.5h.01M7.5 16h.01"/>',
    grid:        '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
    deploy:      '<path d="M12 16V6"/><path d="M8 10l4-4 4 4"/><path d="M5 19h14"/>',
    globe:       '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.5 2.4 2.5 14.6 0 17M12 3.5c-2.5 2.4-2.5 14.6 0 17"/>',
    database:    '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.66 3.13 3 7 3s7-1.34 7-3V6"/><path d="M5 12c0 1.66 3.13 3 7 3s7-1.34 7-3"/>',
    archive:     '<rect x="4" y="5" width="16" height="4" rx="1"/><path d="M5 9v9a2 2 0 002 2h10a2 2 0 002-2V9"/><path d="M10 13h4"/>',
    book:        '<path d="M8 4h8a2 2 0 012 2v13a1 1 0 01-1 1H7a1 1 0 01-1-1V6a2 2 0 012-2z"/><path d="M9 9h6M9 12.5h6M9 16h4"/>',
    bolt:        '<path d="M13 3L5 13h5l-1 8 8-10h-5l1-8z"/>'
  }
  svg_icon = ->(name) {
    "<svg class=\"h-[18px] w-[18px]\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">#{icon_paths[name]}</svg>"
  }
%>
<div class="mx-auto max-w-6xl px-6">
  <!-- ─────────────────────────────  Hero  ───────────────────────────── -->
  <section class="pt-20 pb-16 text-center">
    <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-large bg-primary font-display text-3xl text-white shadow-soft">C</div>
    <div class="mb-4 flex justify-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-warning/40 bg-warning-tint px-3 py-1 text-2xs font-semibold uppercase tracking-label text-warning-deep">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-warning-bright opacity-60"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-warning-bright"></span>
        </span>
        Early alpha · already in production
      </span>
    </div>
    <p class="text-2xs font-semibold uppercase tracking-label text-faint">Self-hosted Ruby on Rails ops · agent-native</p>
    <h1 class="mt-3 font-display text-5xl leading-[1.05] text-ink tracking-display sm:text-6xl">
      The control plane for<br>self-hosted <span class="text-primary">Ruby on Rails</span><span class="ml-1.5 inline-block h-[0.78em] w-[3px] translate-y-[0.06em] rounded-sm bg-primary/70 animate-pulse align-middle" aria-hidden="true"></span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg font-medium text-body">
      Conductor runs, monitors, and maintains your Rails apps across servers you own —
      deploys, routing, Postgres, backups, and security. One control plane instead of
      five dashboards and a pile of SSH, drivable by <strong class="font-semibold text-ink">you or an AI agent</strong>.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <%= link_to "Sign in", user_sign_in_path, class: "rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-white hover:bg-primary-strong" %>
      <%= link_to "Read the docs", "/docs", class: "rounded-md border border-border-strong px-5 py-2.5 text-sm font-medium text-body hover:bg-fill" %>
      <%= link_to "View on GitHub ↗", "https://github.com/nauman/rails-conductor", class: "rounded-md border border-border-strong px-5 py-2.5 text-sm font-medium text-body hover:bg-fill" %>
    </div>
    <p class="mt-4 text-xs text-faint">Source-available · runs on your own infrastructure · no vendor lock-in</p>

    <!-- count-up stats (product facts, not fleet numbers) -->
    <div class="mx-auto mt-12 grid max-w-2xl grid-cols-3 gap-6">
      <% [
        [3, "", "Deploy runtimes", "Kamal · Docker · native"],
        [4, "", "Preflight gates", "migrations · seeds · audit · threads"],
        [100, "%", "Yours to run", "self-hosted · no lock-in"]
      ].each do |target, suffix, label, sub| %>
        <div>
          <div class="font-display text-4xl text-ink tracking-display sm:text-5xl"
               data-controller="counter"
               data-counter-target-value="<%= target %>"
               data-counter-suffix-value="<%= suffix %>"><%= target %><%= suffix %></div>
          <div class="mt-1 text-2xs font-semibold uppercase tracking-label text-muted"><%= label %></div>
          <div class="text-2xs text-faint"><%= sub %></div>
        </div>
      <% end %>
    </div>

    <!-- primitives you already trust -->
    <div class="mx-auto mt-10 flex max-w-3xl flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-2xs uppercase tracking-label text-faint">
      <% %w[Kamal Docker Puma Caddy Postgres S3/R2 SES GitHub].each_with_index do |t, i| %>
        <% if i > 0 %><span class="text-border-strong">·</span><% end %>
        <span><%= t %></span>
      <% end %>
    </div>
  </section>

  <!-- ────────────────  Product texture: agent-native terminal  ──────────────── -->
  <section class="pb-20">
    <div class="mx-auto max-w-3xl overflow-hidden rounded-large border border-border shadow-soft"
         data-controller="mcp-terminal" data-mcp-terminal-delay-value="430">
      <%# window chrome + scene tabs %>
      <div class="flex items-center gap-3 border-b border-white/10 bg-ink px-4 py-2.5">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-danger-bright/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-warning-bright/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-primary-strong/80"></span>
        </div>
        <div class="ml-1 flex items-center gap-1" role="tablist" aria-label="Example MCP sessions">
          <% ["Resume", "Ship", "Operate"].each_with_index do |t, i| %>
            <button type="button" role="tab" data-mcp-terminal-target="tab" data-index="<%= i %>"
                    data-action="mcp-terminal#select"
                    class="rounded-md px-2.5 py-1 font-mono text-2xs text-white/45 transition-colors hover:text-white/80"><%= t %></button>
          <% end %>
        </div>
        <span class="ml-auto hidden font-mono text-2xs text-white/35 sm:block">agent → conductor · MCP</span>
      </div>

      <%# scenes — each a short agent session that types itself out %>
      <div class="overflow-x-auto bg-ink px-5 py-4 font-mono text-xs leading-relaxed text-white/90 min-h-[188px]">
        <%
          req  = ->(tool, args) { "<span class=\"text-primary-sage\">→</span> <span class=\"text-white/80\">#{tool}</span> <span class=\"text-white/45\">#{args}</span>" }
          res  = ->(text) { "<span class=\"text-white/45\">← #{text}</span>" }
          note = ->(text) { "<span class=\"text-white/35\"># #{text}</span>" }
          scenes = [
            [ # Resume
              note.("reconnect — one read to see exactly where things stand"),
              req.("conductor_read", "· action: situation"),
              res.("in_flight:       deploy #128 · acme.com · deploying (2/4 preflight)"),
              res.("needs_attention: shop · seed run failed · runbook attached"),
              res.("recent:          blog #127 ✓ · docs #126 ✓")
            ],
            [ # Ship
              note.("ship the latest commit — the preflight gate runs first"),
              req.("conductor_app", "· action: deploy · app_name: acme.com"),
              res.("preflight: migrations ✓ · seeds ✓ · audit ✓ · threads ✓"),
              res.("build → push → release · gated db:migrate ✓"),
              res.("deploy #128 · kamal · https 200 · 1m52s")
            ],
            [ # Operate
              note.("check the fleet, then read an app's own runbook"),
              req.("conductor_read", "· action: fleet_status"),
              res.("app-01 · online · cpu 6% · load 0.18 · disk 26% · 4 apps"),
              req.("conductor_runbook", "· action: get · app_name: shop"),
              res.("runbook: 5 steps · checklist 4/5 · \"migrate before assets\"")
            ]
          ]
        %>
        <% scenes.each_with_index do |lines, i| %>
          <div data-mcp-terminal-target="scene" data-index="<%= i %>"<%= " hidden".html_safe if i > 0 %>>
            <% lines.each do |line| %>
              <span class="block whitespace-pre-wrap" data-line><%= line.html_safe %></span>
            <% end %>
          </div>
        <% end %>
        <span class="ml-1 inline-block h-3.5 w-2 translate-y-0.5 bg-primary-sage/80 animate-pulse" data-mcp-terminal-target="cursor"></span>
      </div>
    </div>
    <p class="mx-auto mt-4 max-w-2xl text-center text-sm text-muted">
      <span class="text-body">Switch tabs</span> to watch an agent <strong class="text-body">resume</strong> after a
      disconnect, <strong class="text-body">ship</strong> through the preflight gate, and <strong class="text-body">operate</strong>
      the fleet — all over MCP, all idempotent, so retries never double-fire.
    </p>
  </section>
</div>

<!-- ────────────────────  Three ways it's different  ──────────────────── -->
<section class="border-y border-border bg-fill">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <p class="text-center text-2xs font-semibold uppercase tracking-label text-faint">Not another dashboard</p>
    <h2 class="mt-2 text-center font-display text-3xl text-ink tracking-display">Built for how Rails is run now</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <% [
        [:primary, :command, "Agent-native & resumable", "The whole surface is over MCP, and it survives disconnects: an agent reads the fleet situation, picks up in-flight work, and follows each app's own runbook. Idempotent by design.", "conductor_read · situation · conductor_runbook"],
        [:accent, :lock, "Secretless deploys", "Config in your repo carries every non-secret coordinate; real secrets stay in your vault behind a pointer. Clone the repo and bin/kamal just works.", "config/deploy.production.yml · .kamal/secrets"],
        [:info, :server, "Yours to run", "Source-available and self-hosted on servers you already own. A Hatchbox-class control plane with no per-app pricing and no lock-in.", "your servers · your cloud · bare metal"]
      ].each_with_index do |(accent, icon, title, body, mono), i| %>
        <div class="rounded-large border border-border bg-surface p-6 shadow-soft"
             data-controller="reveal" data-reveal-delay-value="<%= i * 90 %>">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-card bg-<%= accent %>-tint text-<%= accent %>">
            <%= svg_icon.(icon).html_safe %>
          </span>
          <h3 class="mt-4 font-display text-xl text-ink"><%= title %></h3>
          <p class="mt-2 text-sm text-body"><%= body %></p>
          <p class="mt-4 font-mono text-2xs text-faint"><%= mono %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- ────────────────────────  Capabilities  ──────────────────────── -->
<div class="mx-auto max-w-6xl px-6">
  <section class="py-16">
    <p class="text-center text-2xs font-semibold uppercase tracking-label text-faint">Everything the fleet needs</p>
    <h2 class="mt-2 text-center font-display text-3xl text-ink tracking-display">One place, end to end</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        [:primary, :grid, "Fleet control", "Every server and app in one view — health, last deploy, and what's running where, live."],
        [:info, :deploy, "Deploy your way", "Kamal, Docker, or native Puma under one control plane — with a preflight gate that blocks a risky ship before it happens."],
        [:accent, :globe, "Routing & edge", "Caddy routes and domains with live TLS; wildcard subdomains and custom domains."],
        [:warning, :database, "Databases", "Hatchbox-style Postgres — a database and role per app, provisioned from the UI."],
        [:primary, :archive, "Backups & data", "Scheduled database backups to S3-compatible object storage, kept off the box."],
        [:accent, :book, "Per-app runbooks", "Every app carries its own deploy runbook + checklist — because each one ships differently. Readable by you and the agent."],
        [:danger, :bolt, "Maintenance & power", "Server audits, security auto-updates, drift checks, and reboots — with a passwordless-sudo readiness check so ops just work."]
      ].each_with_index do |(accent, icon, title, body), i| %>
        <div class="rounded-large border border-border bg-surface p-5 shadow-soft"
             data-controller="reveal" data-reveal-delay-value="<%= i * 70 %>">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-card bg-<%= accent %>-tint text-<%= accent %>"><%= svg_icon.(icon).html_safe %></span>
            <h3 class="text-sm font-semibold text-ink"><%= title %></h3>
          </div>
          <p class="mt-2 text-sm text-body"><%= body %></p>
        </div>
      <% end %>
    </div>
  </section>
</div>

<!-- ─────────────────────  Connected services  ───────────────────── -->
<section class="border-t border-border bg-surface">
  <div class="mx-auto max-w-4xl px-6 py-14 text-center">
    <h2 class="font-display text-2xl text-ink tracking-display">Plugs into what you already use</h2>
    <p class="mx-auto mt-2 max-w-xl text-sm text-muted">
      Connect your accounts once — Conductor wires the rest of the fleet to them.
    </p>

    <%# Available today %>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <% ["Cloudflare", "Cloudflare R2", "GitHub", "Postgres", "Caddy"].each_with_index do |svc, i| %>
        <span class="rounded-full border border-border bg-surface px-4 py-1.5 font-mono text-xs text-body"
              data-controller="reveal" data-reveal-delay-value="<%= i * 55 %>"><%= svc %></span>
      <% end %>
    </div>

    <%# Roadmap — honest about what isn't wired yet %>
    <p class="mt-8 text-2xs font-semibold uppercase tracking-label text-faint">Coming soon</p>
    <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
      <% ["Amazon SES", "Amazon SNS", "Hetzner", "DigitalOcean"].each_with_index do |svc, i| %>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-border-strong bg-transparent px-4 py-1.5 font-mono text-xs text-faint"
              data-controller="reveal" data-reveal-delay-value="<%= i * 55 %>">
          <%= svc %><span class="rounded-full bg-fill px-1.5 py-0.5 text-[9px] uppercase tracking-label text-muted">soon</span>
        </span>
      <% end %>
    </div>
  </div>
</section>

<!-- ────────────────────────────  CTA  ──────────────────────────── -->
<section class="bg-primary-tint">
  <div class="mx-auto max-w-3xl px-6 py-16 text-center">
    <h2 class="font-display text-3xl text-ink tracking-display sm:text-4xl">Take the fleet back.</h2>
    <p class="mx-auto mt-3 max-w-xl font-medium text-body">
      Point Conductor at your servers over SSH and get deploys, routing, databases,
      backups, and security in one control plane — yours to run and yours to script.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <%= link_to "Sign in", user_sign_in_path, class: "rounded-md bg-primary px-6 py-2.5 text-sm font-medium text-white hover:bg-primary-strong" %>
      <%= link_to "View on GitHub ↗", "https://github.com/nauman/rails-conductor", class: "rounded-md border border-border-strong bg-surface px-6 py-2.5 text-sm font-medium text-body hover:bg-fill" %>
    </div>
    <p class="mt-5 font-mono text-2xs uppercase tracking-label text-faint">Source-available · self-hosted · agent-native</p>
  </div>
</section>
