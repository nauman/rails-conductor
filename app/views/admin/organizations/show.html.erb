<section class="mx-auto max-w-3xl">
  <%= link_to "← All organizations", admin_organizations_path, class: "text-sm text-muted hover:text-ink" %>
  <h1 class="mt-2 font-display text-xl text-ink"><%= @organization.name %></h1>
  <p class="mt-1 text-sm text-muted">
    Trust: <strong><%= @organization.trust_level %></strong>
    <% if @organization.self_signed_up? %> · self-signed-up<% end %>
    <% if @organization.card_verified_at %> · card verified <%= @organization.card_verified_at.to_date %><% end %>
  </p>
  <div class="mt-3 flex gap-2">
    <% if @organization.suspended? %>
      <%= button_to "Reinstate", reinstate_admin_organization_path(@organization), class: "rounded-control border border-border px-3 py-1.5 text-sm" %>
    <% else %>
      <%= button_to "Suspend", suspend_admin_organization_path(@organization), class: "rounded-control border border-danger px-3 py-1.5 text-sm text-danger",
            form: { data: { turbo_confirm: "Suspend #{@organization.name}? Its tokens are revoked and Conductor stops connecting to its servers." } } %>
    <% end %>
  </div>

  <div class="mt-6 rounded-large border border-border bg-surface shadow-soft">
    <div class="border-b border-border px-5 py-3 text-sm font-semibold text-body">Members</div>
    <ul class="divide-y divide-border">
      <% @organization.memberships.includes(:user).each do |m| %>
        <li class="flex items-center justify-between px-5 py-3">
          <span class="text-sm text-ink"><%= m.user.email %></span>
          <%= rui_badge(text: m.role, color: m.owner? ? :primary : :slate, size: :sm) %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
