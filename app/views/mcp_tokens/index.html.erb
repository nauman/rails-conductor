<% content_for :title, "MCP Tokens · Conductor" %>

<%= render partial: "shared/page_head",
      locals: {
        title: "Let an agent drive this fleet.",
        lede: "Two ways to give an agent access: connect through the browser (no token to copy or leak), or mint a per-user token scoped to this organization and use it as the bearer token.",
        stats: [
          { value: @connections.size, label: "connected clients" },
          { value: @tokens.size, label: "tokens" }
        ]
      } %>

<section class="max-w-3xl mx-auto px-4 py-8">

  <% if @new_token %>
    <div class=" rounded-large border border-primary/30 bg-primary-tint p-5">
      <div class="text-2xs font-semibold uppercase tracking-label text-primary">New token — copy it now, it won't be shown again</div>
      <code class="mt-2 block font-mono text-xs bg-surface rounded-card px-3 py-2 break-all"><%= @new_token %></code>
    </div>
  <% end %>

  <div class="mt-5 rounded-large border border-border bg-surface p-6 shadow-soft">
    <h2 class="text-sm font-semibold text-ink">Create a token</h2>
    <%= form_with url: mcp_tokens_path, method: :post, class: "mt-4 flex flex-wrap items-end gap-3" do %>
      <div class="flex-1 min-w-[180px]">
        <label class="block text-2xs font-semibold uppercase tracking-label text-muted">Name</label>
        <input type="text" name="name" placeholder="claude-desktop" class="mt-1 block w-full rounded-control border-border-strong text-sm focus:border-primary focus:ring-primary" />
      </div>
      <div>
        <label class="block text-2xs font-semibold uppercase tracking-label text-muted">Scope</label>
        <select name="scope" class="mt-1 block rounded-control border-border-strong text-sm focus:border-primary focus:ring-primary">
          <% if @can_deploy %>
            <option value="deploy">deploy (full)</option>
          <% end %>
          <option value="read">read-only</option>
        </select>
      </div>
      <%= submit_tag "Create token", class: "rounded-control bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-strong cursor-pointer" %>
    <% end %>
    <% unless @can_deploy %>
      <p class="mt-3 text-2xs text-muted">
        Your role is <strong class="text-body"><%= @role || "member" %></strong>, so tokens are read-only.
        Deploying over MCP needs the <strong class="text-body">editor</strong> role — ask an owner of this organization.
      </p>
    <% end %>
  </div>

  <%= render "connect",
        endpoint: "#{request.base_url}/mcp",
        token: (@new_token || "$CONDUCTOR_MCP_TOKEN"),
        fresh: @new_token.present? %>

  <div class="mt-6 rounded-large border border-border bg-surface shadow-soft overflow-hidden">
    <div class="px-6 py-4 border-b border-border">
      <h2 class="text-sm font-semibold text-ink">Connected clients</h2>
      <p class="mt-1 text-2xs text-muted">Agents you connected by signing in through the browser (OAuth). Revoking cuts off the client immediately, including its ability to refresh.</p>
    </div>
    <table class="min-w-full">
      <thead class="bg-fill">
        <tr class="text-2xs font-semibold uppercase tracking-label text-muted">
          <th class="px-6 py-3 text-left">Client</th>
          <th class="px-6 py-3 text-left">Access</th>
          <th class="px-6 py-3 text-left">Connected</th>
          <th class="px-6 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @connections.each do |connection| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-ink"><%= connection.application&.name || "Unknown client" %></td>
            <td class="px-6 py-4"><span class="inline-flex items-center rounded-pill px-2.5 py-1 text-2xs font-semibold uppercase tracking-label <%= connection.scopes.include?("mcp") ? 'bg-primary-tint text-primary' : 'bg-info-tint text-info' %>"><%= connection.scopes.to_s %></span></td>
            <td class="px-6 py-4 text-sm text-muted"><%= time_ago_in_words(connection.created_at) %> ago</td>
            <td class="px-6 py-4 text-right">
              <%= button_to "Revoke", oauth_connection_path(connection.application_id), method: :delete,
                    data: { turbo_confirm: "Revoke this connection? The client will have to sign in again." },
                    class: "text-2xs font-semibold uppercase tracking-label text-danger hover:text-danger-deep" %>
            </td>
          </tr>
        <% end %>
        <% if @connections.empty? %>
          <tr><td colspan="4" class="px-6 py-6 text-sm text-muted">No connected clients. Point an MCP client at <code class="font-mono text-2xs"><%= request.base_url %>/mcp</code> and it will walk you through signing in.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6 rounded-large border border-border bg-surface shadow-soft overflow-hidden">
    <div class="px-6 py-4 border-b border-border">
      <h2 class="text-sm font-semibold text-ink">API tokens</h2>
      <p class="mt-1 text-2xs text-muted">Bearer tokens you created by hand, for clients that can't sign in through the browser. Separate from connected clients above — an agent needs one or the other, not both.</p>
    </div>
    <table class="min-w-full">
      <thead class="bg-fill">
        <tr class="text-2xs font-semibold uppercase tracking-label text-muted">
          <th class="px-6 py-3 text-left">Name</th>
          <th class="px-6 py-3 text-left">Scope</th>
          <th class="px-6 py-3 text-left">Last used</th>
          <th class="px-6 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @tokens.each do |t| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-ink"><%= t.name %></td>
            <td class="px-6 py-4"><span class="inline-flex items-center rounded-pill px-2.5 py-1 text-2xs font-semibold uppercase tracking-label <%= t.read_only? ? 'bg-info-tint text-info' : 'bg-primary-tint text-primary' %>"><%= t.scope %></span></td>
            <td class="px-6 py-4 text-sm text-muted"><%= t.last_used_at ? "#{time_ago_in_words(t.last_used_at)} ago" : "never" %></td>
            <td class="px-6 py-4 text-right">
              <%= button_to "Revoke", mcp_token_path(t), method: :delete, data: { turbo_confirm: "Revoke this token?" }, class: "text-2xs font-semibold uppercase tracking-label text-danger hover:text-danger-deep" %>
            </td>
          </tr>
        <% end %>
        <% if @tokens.empty? %>
          <tr><td colspan="4" class="px-6 py-10 text-center text-sm text-muted">
            <% if @connections.any? %>
              No tokens — and you may not need any. <%= @connections.size == 1 ? "Your connected client above already has" : "Your connected clients above already have" %> access.
            <% else %>
              No tokens yet. Create one above for your agent.
            <% end %>
          </td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
