<%# Lazy turbo-frame: loaded + refreshed via servers#storage. %>
<%= turbo_frame_tag dom_id(server, :storage) do %>
  <div class="rounded-large border border-border bg-surface p-5 shadow-soft">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-lg text-ink">Storage</h2>
      <%= link_to storage_server_path(server), class: "text-xs font-medium text-muted hover:text-ink" do %>Refresh<% end %>
    </div>

    <% if !storage.ok? %>
      <p class="mt-3 text-sm text-danger-deep"><%= storage.error %></p>
    <% else %>
      <%# --- Filesystems --- %>
      <div class="mt-4 space-y-3">
        <% storage.mounts.each do |m| %>
          <% bar = m.percent >= 90 ? "bg-danger" : m.percent >= 75 ? "bg-warning" : "bg-primary" %>
          <div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-body font-medium"><%= m.mount %> <span class="text-faint font-normal">(<%= m.filesystem %>)</span></span>
              <span class="text-muted"><%= number_to_human_size(m.used) %> / <%= number_to_human_size(m.size) %> · <%= number_to_human_size(m.avail) %> free</span>
            </div>
            <div class="mt-1 h-2 w-full overflow-hidden rounded-pill bg-fill-strong">
              <div class="h-full <%= bar %>" style="width: <%= [m.percent, 100].min %>%"></div>
            </div>
          </div>
        <% end %>
      </div>

      <%# --- Swap + Memory + Inodes --- %>
      <div class="mt-5 grid gap-4 sm:grid-cols-3 text-sm">
        <% [["Memory", storage.memory], ["Swap", storage.swap]].each do |label, u| %>
          <div class="rounded-lg bg-fill p-3">
            <div class="text-xs uppercase tracking-wide text-faint"><%= label %></div>
            <% if u %>
              <div class="mt-1 text-body"><%= number_to_human_size(u[:used]) %> / <%= number_to_human_size(u[:total]) %></div>
              <div class="text-xs text-muted"><%= u[:percent] %>% used</div>
            <% else %>
              <div class="mt-1 text-muted"><%= label == "Swap" ? "none" : "—" %></div>
            <% end %>
          </div>
        <% end %>
        <% root_inode = storage.inodes.find { |i| i.mount == "/" } || storage.inodes.first %>
        <div class="rounded-lg bg-fill p-3">
          <div class="text-xs uppercase tracking-wide text-faint">Inodes (/)</div>
          <% if root_inode %>
            <div class="mt-1 text-body"><%= number_with_delimiter(root_inode.used) %> used</div>
            <div class="text-xs text-muted"><%= root_inode.percent %>% of <%= number_with_delimiter(root_inode.size) %></div>
          <% else %>
            <div class="mt-1 text-muted">—</div>
          <% end %>
        </div>
      </div>

      <%# --- Largest directories --- %>
      <% if storage.top_dirs.any? %>
        <div class="mt-5">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Largest directories</h3>
          <% max = storage.top_dirs.map(&:bytes).max.to_f %>
          <ul class="mt-2 space-y-1.5">
            <% storage.top_dirs.first(12).each do |d| %>
              <li class="flex items-center gap-3 text-sm">
                <code class="w-56 shrink-0 truncate text-xs text-body" title="<%= d.path %>"><%= d.path %></code>
                <div class="h-1.5 flex-1 overflow-hidden rounded-pill bg-fill-strong">
                  <div class="h-full bg-primary/60" style="width: <%= max.zero? ? 0 : (d.bytes / max * 100).round %>%"></div>
                </div>
                <span class="w-16 shrink-0 text-right font-mono text-xs text-muted"><%= number_to_human_size(d.bytes) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
