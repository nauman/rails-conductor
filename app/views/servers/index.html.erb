<% content_for :title, "Servers · Conductor" %>

<%# Capacity cards, the same ones the dashboard shows — bars rather than four numbers in
    boxes, because the question is how much room is left, not what the value is. Reusing
    the dashboard partial keeps a server from looking like two different things on two
    pages. %>
<% strained = @servers.count { |s| s.cpu_percent.to_i >= 60 || s.disk_percent.to_i >= 80 } %>
<% offline = @servers.size - @online_count.to_i %>
<%= render layout: "shared/page_head",
      locals: {
        title: if offline.positive?
                 "#{pluralize(offline, "server")} offline."
               elsif strained.positive?
                 "#{pluralize(strained, "box")} under pressure."
               else
                 "Fleet has room."
               end,
        stats: [
          { value: @servers.size, label: "servers" },
          { value: @online_count, label: "online", tone: offline.positive? ? :danger : :default },
          { value: "#{@running_app_count}/#{@app_count}", label: "apps running", url: apps_path },
          ({ value: strained, label: "near capacity", tone: :warning } if strained.positive?)
        ].compact
      } do %>
  <%= rui_button("New server", url: new_server_path, color: :primary, size: :md) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8 space-y-5">
  <% if @servers.any? %>
    <div class="grid gap-4 lg:grid-cols-3">
      <% @servers.each do |server| %>
        <%= render "dashboard/server_card", server: server %>
      <% end %>
    </div>

    <%# The card shows load; this shows placement. Which app sits on which box is the other
        half of every capacity decision, and it's the thing you'd act on. %>
    <%= render layout: "shared/panel", locals: { title: "Placement", flush: true,
              meta: "#{@app_count} #{"app".pluralize(@app_count)} across #{pluralize(@servers.size, "server")}" } do %>
      <div class="divide-y divide-border">
        <% @servers.each do |server| %>
          <% apps = server.apps.sort_by { |a| [ a.status == "running" ? 0 : 1, a.name.downcase ] } %>
          <div class="flex flex-col gap-2 px-5 py-3 sm:flex-row sm:items-center sm:gap-4">
            <div class="w-full min-w-0 sm:w-48">
              <%= link_to server.name, server_path(server), class: "text-sm font-medium text-ink hover:underline" %>
              <div class="font-mono text-2xs text-faint"><%= server.region.presence || server.provider.presence || server.ip_address %></div>
            </div>
            <div class="flex min-w-0 flex-1 flex-wrap gap-1.5">
              <% if apps.any? %>
                <% apps.each do |app| %>
                  <%= link_to app.name, app_path(app),
                        title: app.status,
                        class: "rounded-card bg-fill px-2 py-1 font-mono text-2xs hover:bg-fill-strong #{app.deploy_failing? ? "text-danger-deep" : app.status == "running" ? "text-body" : "text-muted"}" %>
                <% end %>
              <% else %>
                <span class="font-mono text-2xs text-faint">no apps — spare capacity</span>
              <% end %>
            </div>
            <div class="shrink-0">
              <%= link_to "Manage", server_path(server), class: "font-mono text-2xs uppercase tracking-label text-muted hover:text-ink" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-large border border-dashed border-border-strong bg-fill p-12 text-center">
      <h2 class="font-display text-xl text-ink">No servers yet</h2>
      <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
        Conductor manages servers you already own, over SSH. Add one to see live health,
        run deploys, and manage routing.
      </p>
      <%= rui_button "Add your first server", url: new_server_path, color: :primary, class: "mt-5" %>
      <p class="mt-3 font-mono text-2xs text-faint">You'll need an SSH key and the server's IP.</p>
    </div>
  <% end %>
</section>
