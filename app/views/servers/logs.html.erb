<% content_for :title, "Logs · #{@server.name} · Conductor" %>

<%# Server logs. The header says WHICH stream you're reading, because a container's stdout
    and the host journal answer different questions. %>
<%= render layout: "shared/page_head",
      locals: {
        eyebrow: @server.name,
        title: @container ? "Container output · #{@container}" : "System journal.",
        lede: "Last #{@tail} lines, re-read on a timer. Conductor tails the box — it doesn't store your logs.",
        stats: [
          { value: @server.display_status, label: "server", tone: @server.display_status == "online" ? :default : :danger },
          { value: @tail, label: "lines" },
          { value: @container || "host journal", label: "source" }
        ]
      } do %>
  <label class="inline-flex cursor-pointer items-center gap-2 rounded-control border border-border-strong bg-surface px-3 py-2 text-sm font-medium text-body hover:bg-fill">
    <input type="checkbox" id="auto-refresh" checked class="rounded border-border-strong text-ink focus:ring-primary">
    <span>Live tail</span>
  </label>
  <%= rui_button("Re-read", url: logs_server_path(@server, container: @container), id: "manual-refresh", variant: :outline, color: :slate) %>
  <%= rui_button("Back to server", url: server_path(@server), variant: :outline, color: :slate) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8">
  <details class="mb-4 text-2xs text-muted">
    <summary class="cursor-pointer font-mono uppercase tracking-label hover:text-body">Tail it on the box</summary>
    <pre class="mt-2 overflow-x-auto whitespace-pre-wrap rounded-card bg-ink px-3 py-2 font-mono text-2xs text-faint">ssh <%= @server.ssh_user %>@<%= @server.ip_address %>
<%= @container ? "docker logs -f --tail #{@tail} #{@container}" : "journalctl -n #{@tail} -f" %></pre>
  </details>

  <%# Source picker: system journal + each app's container (incl. Conductor itself) %>
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "System (journalctl)", logs_server_path(@server),
          class: "inline-flex items-center gap-2 rounded-pill px-3 py-1.5 font-mono text-2xs border #{@container ? 'border-border text-muted hover:bg-fill' : 'border-primary bg-primary-tint text-primary'}" %>
    <% @containers.each do |app| %>
      <%= link_to app.container_name, logs_server_path(@server, container: app.container_name),
            class: "inline-flex items-center gap-2 rounded-pill px-3 py-1.5 font-mono text-2xs border #{@container == app.container_name ? 'border-primary bg-primary-tint text-primary' : 'border-border text-muted hover:bg-fill'}" %>
    <% end %>
  </div>

  <div class="mt-6 rounded-large border border-border-strong bg-ink shadow-soft overflow-hidden" id="log-container">
    <div class="p-4 border-b border-border-strong flex items-center justify-between">
      <h2 class="font-mono text-2xs uppercase tracking-label text-white/70"><%= @container ? "docker logs #{@container}" : "journalctl @ #{@server.name}" %></h2>
      <div class="flex items-center gap-3">
        <span id="refresh-indicator" class="hidden">
          <svg class="h-4 w-4 text-faint animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
        <span id="last-updated" class="text-xs text-faint">Updated just now</span>
      </div>
    </div>
    <div class="p-4 max-h-[700px] overflow-y-auto" id="log-content">
      <% if @logs.present? %>
        <pre class="text-sm text-faint font-mono whitespace-pre-wrap"><%= @logs %></pre>
      <% else %>
        <p class="text-sm text-muted">No logs available.</p>
      <% end %>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const checkbox = document.getElementById('auto-refresh');
    const logContent = document.getElementById('log-content');
    const refreshIndicator = document.getElementById('refresh-indicator');
    const lastUpdated = document.getElementById('last-updated');
    const url = '<%= logs_server_path(@server, container: @container, format: :json) %>';
    let intervalId = null;

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function fetchLogs() {
      refreshIndicator.classList.remove('hidden');
      fetch(url)
        .then(r => r.json())
        .then(data => {
          logContent.innerHTML = data.logs
            ? '<pre class="text-sm text-faint font-mono whitespace-pre-wrap">' + escapeHtml(data.logs) + '</pre>'
            : '<p class="text-sm text-muted">No logs available.</p>';
          lastUpdated.textContent = 'Updated just now';
          refreshIndicator.classList.add('hidden');
          logContent.scrollTop = logContent.scrollHeight;
        })
        .catch(() => refreshIndicator.classList.add('hidden'));
    }

    checkbox.addEventListener('change', function() {
      if (this.checked) {
        fetchLogs();
        intervalId = setInterval(fetchLogs, 3000);
      } else if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    });

    if (checkbox.checked) {
      fetchLogs();
      intervalId = setInterval(fetchLogs, 3000);
    }
  });
</script>
