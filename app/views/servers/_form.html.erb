<%= form_with model: server, class: "space-y-6" do |f| %>
  <% if server.errors.any? %>
    <div class="rounded-card border border-danger/30 bg-danger-tint p-4">
      <div class="text-sm font-medium text-danger-deep">Please fix the following errors:</div>
      <ul class="mt-2 list-disc list-inside text-sm text-danger-deep">
        <% server.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-card border border-info/30 bg-info-tint p-4">
    <p class="text-sm text-info">
      Register an existing server so Conductor can reach it over SSH. You only need a
      <strong>name</strong>, its <strong>IP address</strong>, and an <strong>SSH key</strong>.
      CPU, memory, disk, and status fill in automatically once Conductor connects — you don't
      enter those by hand.
    </p>
  </div>

  <div class="rounded-large border border-border bg-surface p-6 shadow-soft space-y-6">
    <h2 class="text-sm font-semibold text-ink">Basics</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= f.label :name, class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "edge-hel1" %>
        <p class="mt-1 text-2xs text-faint">A label for you — any name that's unique in your fleet.</p>
      </div>

      <div>
        <%= f.label :ip_address, "IP address", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.text_field :ip_address, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "203.0.113.10" %>
        <p class="mt-1 text-2xs text-faint">The public IP Conductor connects to.</p>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= f.label :provider, "Provider (optional)", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.select :provider, Server::PROVIDERS.map { |p| [p.titleize, p] }, { include_blank: "—" }, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
      </div>

      <div>
        <%= f.label :region, "Region (optional)", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.text_field :region, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "Helsinki" %>
      </div>
    </div>
  </div>

  <div class="rounded-large border border-border bg-surface p-6 shadow-soft space-y-6">
    <div>
      <h2 class="text-sm font-semibold text-ink">SSH connection</h2>
      <p class="mt-1 text-2xs text-muted">How Conductor logs in to deploy, run scripts, and read metrics.</p>
    </div>

    <div>
      <%= f.label :ssh_key_id, "SSH key", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
      <% org_ssh_keys = current_organization.ssh_keys.order(:name) %>
      <% if org_ssh_keys.any? %>
        <%= f.collection_select :ssh_key_id, org_ssh_keys, :id, :name, { include_blank: "Select SSH key" }, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
        <p class="mt-1 text-2xs text-muted">
          Don't see the right one? <%= link_to "Add an SSH key", new_ssh_key_path, class: "text-primary hover:underline" %>.
        </p>
      <% else %>
        <div class="mt-1 rounded-lg border border-dashed border-border-strong bg-fill p-4 text-sm text-muted">
          You haven't added an SSH key yet — Conductor needs one to connect.
          <%= link_to "Add your first SSH key", new_ssh_key_path, class: "font-medium text-primary hover:underline" %>,
          then come back here.
        </div>
      <% end %>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= f.label :ssh_user, "SSH user", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.text_field :ssh_user, value: (f.object.ssh_user.presence || "root"), class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "root" %>
        <p class="mt-1 text-2xs text-faint">The account Conductor logs in as. Usually <code class="text-2xs">root</code> or <code class="text-2xs">deploy</code>.</p>
      </div>

      <div>
        <%= f.label :ssh_port, "SSH port", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.number_field :ssh_port, value: (f.object.ssh_port.presence || 22), class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "22", min: 1, max: 65535 %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <%= link_to "Cancel", servers_path, class: "text-sm font-medium text-body hover:text-ink" %>
    <%= f.submit server.persisted? ? "Save changes" : "Add server", class: "inline-flex items-center rounded-control bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-body cursor-pointer" %>
  </div>
  <% unless server.persisted? %>
    <p class="text-right text-xs text-faint">Next: open the server and hit <em>Test connection</em> to confirm SSH works.</p>
  <% end %>
<% end %>
