<%# Lazy turbo-frame: loaded + re-checked via servers#audit. %>
<%= turbo_frame_tag dom_id(server, :audit) do %>
  <div class="rounded-large border border-border bg-surface p-5 shadow-soft">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-lg text-ink">Security audit</h2>
      <div class="flex items-center gap-3">
        <% rollup = { secure: "text-success", attention: "text-warning", at_risk: "text-danger", unknown: "text-muted" }[audit.status] %>
        <span class="text-xs font-semibold uppercase tracking-wide <%= rollup %>"><%= audit.status.to_s.tr("_", " ") %></span>
        <%= link_to "Re-check", audit_server_path(server), class: "text-xs font-medium text-muted hover:text-ink" %>
      </div>
    </div>

    <% if audit.ok? %>
      <ul class="mt-3 divide-y divide-border">
        <% audit.checks.each do |c| %>
          <% color = { ok: "text-success", warn: "text-warning", fail: "text-danger", info: "text-muted" }[c.status] %>
          <% dot   = { ok: "bg-success", warn: "bg-warning", fail: "bg-danger", info: "bg-border-strong" }[c.status] %>
          <li class="flex items-center justify-between py-2 text-sm">
            <span class="flex items-center gap-2 text-body">
              <span class="inline-block h-1.5 w-1.5 rounded-full <%= dot %>"></span>
              <%= c.label %>
            </span>
            <span class="font-mono text-xs <%= color %>"><%= c.detail %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-danger"><%= audit.error %></p>
      <p class="mt-1 text-xs text-muted">Check SSH connectivity (and that the deploy user has passwordless sudo), then re-check.</p>
    <% end %>
  </div>
<% end %>
