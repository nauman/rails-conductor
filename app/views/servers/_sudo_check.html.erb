<%# Lazy turbo-frame: passwordless-sudo readiness, loaded via servers#sudo_check.
    Privileged fleet ops (updates, reboot) need a NOPASSWD grant — the same one-time
    setup Hatchbox does at provision time. %>
<%= turbo_frame_tag dom_id(server, :sudo_check) do %>
  <div class="rounded-large border border-border bg-surface p-5 shadow-soft">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-1.5">
        <h3 class="text-sm font-semibold text-ink">Privileged ops readiness</h3>
        <%# Info popover (zero-JS <details>): what/how/why, so any operator has context. %>
        <details class="relative">
          <summary class="flex cursor-pointer list-none items-center text-faint hover:text-ink [&::-webkit-details-marker]:hidden" aria-label="About privileged ops readiness">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 16v-4M12 8h.01"/></svg>
          </summary>
          <div class="absolute left-0 z-20 mt-2 w-80 rounded-large border border-border bg-surface p-4 text-left shadow-soft">
            <p class="text-xs font-semibold text-ink">Why this panel exists</p>
            <p class="mt-1.5 text-xs text-muted"><span class="font-medium text-body">What:</span> OS updates &amp; reboots need root. Conductor runs them over SSH.</p>
            <p class="mt-1.5 text-xs text-muted"><span class="font-medium text-body">How:</span> as the <span class="font-mono">deploy</span> user via <span class="font-mono">sudo -n</span> (no prompt), using a one-time grant of a few root-owned wrapper scripts — no permanent root SSH.</p>
            <p class="mt-1.5 text-xs text-muted"><span class="font-medium text-body">Why safe:</span> <span class="font-mono">NOPASSWD</span> is granted only on those fixed wrapper scripts (no args) — never blanket sudo, and no shell escape (unlike a raw <span class="font-mono">apt-get</span> grant).</p>
            <%# target _top: this link lives inside the sudo_check turbo-frame, so
                without it Turbo would load /docs into the frame → "Content missing". %>
            <%= link_to "Full guide + hardening →", guide_path("privileged-ops"),
                  target: "_top", data: { turbo_frame: "_top" },
                  class: "mt-2.5 inline-block text-xs font-medium text-primary hover:text-primary-strong" %>
          </div>
        </details>
      </div>
      <% if ready.nil? %>
        <span class="rounded-full bg-fill px-2 py-0.5 text-2xs font-semibold text-muted">SSH not configured</span>
      <% elsif ready %>
        <span class="rounded-full bg-primary-tint px-2 py-0.5 text-2xs font-semibold text-primary-strong">Ready</span>
      <% else %>
        <span class="rounded-full bg-warning-tint px-2 py-0.5 text-2xs font-semibold text-warning-deep">Setup needed</span>
      <% end %>
    </div>

    <% if ready == false %>
      <p class="mt-2 text-xs text-muted">
        Updates and reboot run as <span class="font-mono"><%= server.ssh_user_or_default %></span> via <code class="font-mono">sudo -n</code>,
        but this server prompts for a password. Grant passwordless sudo once — as root (or a sudo user) on the server:
      </p>
      <pre class="mt-3 overflow-x-auto rounded-base bg-ink px-3 py-2.5 font-mono text-2xs leading-relaxed text-white/90"><%= grant_command %></pre>
      <p class="mt-2 text-2xs text-faint">Same grant Hatchbox sets up at provisioning — no permanent root SSH needed.</p>
    <% elsif ready %>
      <p class="mt-2 text-xs text-muted">Passwordless sudo is configured — updates and reboot will run cleanly.</p>
    <% end %>
  </div>
<% end %>
