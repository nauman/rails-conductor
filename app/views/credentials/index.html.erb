<% content_for :title, "Credentials · Conductor" %>

<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="font-display text-2xl text-ink tracking-display">Credentials</h1>
      <p class="mt-1 text-sm text-muted">Manage API keys and secrets.</p>
    </div>
    <%= link_to new_credential_path, class: "inline-flex items-center gap-2 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-body" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Add Credential
    <% end %>
  </div>

  <% if @credentials.any? %>
    <div class="mt-6 rounded-large border border-border bg-surface shadow-soft overflow-hidden">
      <table class="min-w-full divide-y divide-border">
        <thead class="bg-fill">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted">Name</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted">Provider</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted">API Key</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted">Status</th>
            <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-muted">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @credentials.each do |credential| %>
            <tr>
              <td class="px-6 py-4 text-sm font-medium text-ink"><%= credential.name %></td>
              <td class="px-6 py-4 text-sm text-muted"><%= credential.provider.titleize %></td>
              <td class="px-6 py-4 text-sm text-muted">
                <code class="bg-fill-strong px-2 py-1 rounded text-xs"><%= credential.masked_api_key %></code>
              </td>
              <td class="px-6 py-4">
                <% if credential.active? %>
                  <span class="inline-flex items-center rounded-full bg-primary-tint px-2.5 py-1 text-xs font-semibold text-primary ring-1 ring-inset ring-primary/30">Active</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-fill-strong px-2.5 py-1 text-xs font-semibold text-body ring-1 ring-inset ring-border">Inactive</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-right text-sm">
                <% if credential.verifiable? %>
                  <%= button_to "Verify", verify_credential_path(credential), method: :post,
                      class: "font-medium text-primary hover:text-primary-strong", form_class: "inline" %>
                  <span class="text-faint mx-2">·</span>
                <% end %>
                <%= link_to "Edit", edit_credential_path(credential), class: "font-medium text-body hover:text-ink" %>
                <span class="text-faint mx-2">·</span>
                <%= button_to "Delete", credential_path(credential), method: :delete,
                    data: { turbo_confirm: "Are you sure?" },
                    class: "font-medium text-danger hover:text-danger-deep", form_class: "inline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% cf = @credentials.select(&:cloudflare?) %>
    <% if cf.any? %>
      <div class="mt-10">
        <h2 class="font-display text-xl text-ink tracking-display">Cloudflare connections</h2>
        <p class="mt-1 text-sm text-muted">
          Connect multiple accounts. <strong class="text-body">Verify</strong> caches each account's zones so Conductor
          can resolve which account owns a domain. Then attach Cloudflare's MCP to give an agent the full Cloudflare API.
          <%= link_to "Guide →", "/docs/cloudflare-mcp", class: "font-medium text-primary hover:text-primary-strong", target: "_top" %>
        </p>

        <div class="mt-3 rounded-base border border-border bg-fill p-3">
          <div class="text-2xs font-semibold uppercase tracking-label text-faint">Using Claude Code? Install the plugin instead</div>
          <pre class="mt-1.5 overflow-x-auto rounded-base bg-ink px-3 py-2.5 font-mono text-2xs leading-relaxed text-white/90">claude plugin marketplace add cloudflare/skills
claude plugin install cloudflare@cloudflare
# then run /reload-plugins inside Claude</pre>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <% cf.each do |c| %>
            <div class="rounded-large border border-border bg-surface p-5 shadow-soft">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-semibold text-ink"><%= c.name %></h3>
                  <% if c.verified? %>
                    <span class="rounded-full bg-primary-tint px-2 py-0.5 text-2xs font-semibold text-primary-strong">Verified · <%= c.zones_list.size %> zones</span>
                  <% else %>
                    <span class="rounded-full bg-warning-tint px-2 py-0.5 text-2xs font-semibold text-warning-deep">Not verified</span>
                  <% end %>
                </div>
                <%= button_to (c.verified? ? "Re-verify" : "Verify"), verify_credential_path(c), method: :post,
                      class: "rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-medium text-body hover:bg-fill" %>
              </div>

              <% if c.zones_list.any? %>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  <% c.zones_list.first(12).each do |z| %>
                    <span class="rounded-full border border-border bg-fill px-2 py-0.5 font-mono text-2xs text-body"><%= z["name"] %></span>
                  <% end %>
                  <% if c.zones_list.size > 12 %><span class="text-2xs text-faint">+<%= c.zones_list.size - 12 %> more</span><% end %>
                </div>
              <% end %>

              <div class="mt-4">
                <div class="text-2xs font-semibold uppercase tracking-label text-faint">Attach Cloudflare MCP — read-only (this account)</div>
                <pre class="mt-1.5 overflow-x-auto rounded-base bg-ink px-3 py-2.5 font-mono text-2xs leading-relaxed text-white/90"><%= c.cloudflare_mcp_command %></pre>
                <p class="mt-1 text-2xs text-faint">
                  OAuth triggers on first use — authorize the <span class="font-mono"><%= c.name %></span> account. No token in the command.
                  These servers are <strong>diagnosis-only</strong> (docs, analytics, observability). To change config, use
                  <span class="font-mono">Put behind Cloudflare</span> on an app — the only path that mutates, and it's audited.
                </p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="mt-6 rounded-large border border-dashed border-border-strong bg-fill p-12 text-center">
      <div class="text-sm text-muted">No credentials yet.</div>
      <%= link_to "Add your first credential", new_credential_path, class: "mt-2 inline-block text-sm font-medium text-ink hover:underline" %>
    </div>
  <% end %>
</section>
