<% content_for :title, "Credentials · Conductor" %>

<%# Connected services. A credential Conductor has never verified may name an account its
    token can no longer reach, so verification state leads rather than "active". %>
<% verified = @credentials.count(&:verified?) %>
<% unverified = @credentials.select { |c| c.verifiable? && !c.verified? } %>
<%= render layout: "shared/page_head",
      locals: {
        title: if @credentials.empty?
                 "Nothing connected yet."
               elsif unverified.any?
                 "#{pluralize(unverified.size, "credential")} #{unverified.size == 1 ? "hasn't" : "haven't"} been verified."
               else
                 "#{pluralize(@credentials.size, "service")} connected."
               end,
        lede: "Keys Conductor uses to reach storage, DNS and registries on your behalf. Verifying proves the token still works and caches what the account owns.",
        stats: [
          { value: @credentials.size, label: "credentials" },
          { value: verified, label: "verified", tone: unverified.any? ? :warning : :default },
          { value: @credentials.count(&:active?), label: "active" }
        ]
      } do %>
  <%= rui_button("Add credential", url: new_credential_path, color: :primary, size: :md) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8 space-y-5">
  <% if @credentials.any? %>
    <%= render layout: "shared/panel", locals: { title: "Credentials", flush: true } do %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="bg-fill font-mono text-2xs uppercase tracking-label text-muted">
              <th class="px-5 py-2 text-left font-semibold">Name</th>
              <th class="px-5 py-2 text-left font-semibold">Provider</th>
              <th class="px-5 py-2 text-left font-semibold">Key</th>
              <th class="px-5 py-2 text-left font-semibold">State</th>
              <th class="px-5 py-2 text-right font-semibold"></th>
            </tr>
          </thead>
          <tbody>
            <% @credentials.each do |credential| %>
              <tr class="border-t border-border hover:bg-bg-alt">
                <td class="px-5 py-2.5 font-medium text-ink"><%= credential.name %></td>
                <td class="px-5 py-2.5 font-mono text-2xs text-muted"><%= credential.provider.titleize %></td>
                <td class="px-5 py-2.5"><code class="rounded bg-fill-strong px-2 py-1 font-mono text-2xs"><%= credential.masked_api_key %></code></td>
                <td class="px-5 py-2.5">
                  <span class="font-mono text-2xs font-semibold <%= credential.active? ? "text-primary" : "text-muted" %>">
                    <%= credential.active? ? "active" : "inactive" %>
                  </span>
                  <% if credential.verifiable? %>
                    <span class="block font-mono text-2xs <%= credential.verified? ? "text-faint" : "text-warning-deep" %>">
                      <%= credential.verified? ? "verified" : "never verified" %>
                    </span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-5 py-2.5 text-right">
                  <% if credential.verifiable? %>
                    <%= rui_button_to("Verify", verify_credential_path(credential), method: :post, variant: :ghost, size: :sm, color: :slate) %>
                  <% end %>
                  <%= rui_button("Edit", url: edit_credential_path(credential), variant: :ghost, size: :sm, color: :slate) %>
                  <%= rui_button_to("Delete", credential_path(credential), method: :delete, variant: :ghost, size: :sm, color: :danger,
                        data: { turbo_confirm: "Delete #{credential.name}?" }) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% cf = @credentials.select(&:cloudflare?) %>
    <% if cf.any? %>
      <%= render layout: "shared/panel",
            locals: { title: "Cloudflare accounts",
                      meta: "verifying caches each account's zones so Conductor can tell which account owns a domain" } do %>
        <div class="rounded-card border border-border bg-fill p-3">
          <div class="font-mono text-2xs uppercase tracking-label text-faint">Using Claude Code? Install the plugin instead</div>
          <pre class="mt-1.5 overflow-x-auto rounded-card bg-ink px-3 py-2.5 font-mono text-2xs leading-relaxed text-white/90">claude plugin marketplace add cloudflare/skills
claude plugin install cloudflare@cloudflare
# then run /reload-plugins inside Claude</pre>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <% cf.each do |c| %>
            <div class="rounded-card border border-border bg-bg-alt p-4">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-semibold text-ink"><%= c.name %></h3>
                  <span class="rounded-pill px-2 py-0.5 font-mono text-2xs font-semibold <%= c.verified? ? "bg-primary-tint text-primary-strong" : "bg-warning-tint text-warning-deep" %>">
                    <%= c.verified? ? "verified · #{c.zones_list.size} zones" : "not verified" %>
                  </span>
                </div>
                <%= rui_button_to((c.verified? ? "Re-verify" : "Verify"), verify_credential_path(c), method: :post,
                      variant: :outline, size: :sm, color: :slate) %>
              </div>

              <% if c.zones_list.any? %>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  <% c.zones_list.first(12).each do |z| %>
                    <span class="rounded-pill border border-border bg-fill px-2 py-0.5 font-mono text-2xs text-body"><%= z["name"] %></span>
                  <% end %>
                  <% if c.zones_list.size > 12 %>
                    <span class="font-mono text-2xs text-faint">+<%= c.zones_list.size - 12 %> more</span>
                  <% end %>
                </div>
              <% end %>

              <div class="mt-4">
                <div class="font-mono text-2xs uppercase tracking-label text-faint">Attach Cloudflare MCP — read-only</div>
                <pre class="mt-1.5 overflow-x-auto rounded-card bg-ink px-3 py-2.5 font-mono text-2xs leading-relaxed text-white/90"><%= c.cloudflare_mcp_command %></pre>
                <p class="mt-1 text-2xs text-faint">
                  OAuth triggers on first use — authorize the <span class="font-mono"><%= c.name %></span> account; no token in the
                  command. These servers are <strong>diagnosis-only</strong>. To change config, use
                  <span class="font-mono">Put behind Cloudflare</span> on an app — the only path that mutates, and it's audited.
                  <%= link_to "Guide →", "/docs/cloudflare-mcp", class: "font-medium text-primary hover:text-primary-strong", target: "_top" %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="rounded-large border border-dashed border-border-strong bg-fill p-12 text-center">
      <h2 class="font-display text-xl text-ink">No credentials yet</h2>
      <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
        Connect storage for backups, DNS for routing, or a registry for images. Conductor
        can't protect a database until it has somewhere to put the dump.
      </p>
      <%= rui_button "Add your first credential", url: new_credential_path, color: :primary, class: "mt-5" %>
    </div>
  <% end %>
</section>
