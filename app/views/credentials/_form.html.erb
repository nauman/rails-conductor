<%= form_with model: credential, class: "space-y-6", data: { controller: "credential-form" } do |f| %>
  <% if credential.errors.any? %>
    <div class="rounded-card border border-danger/30 bg-danger-tint p-4">
      <div class="text-sm font-medium text-danger-deep">Please fix the following errors:</div>
      <ul class="mt-2 list-disc list-inside text-sm text-danger-deep">
        <% credential.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-large border border-border bg-surface p-6 shadow-soft space-y-6">
    <div>
      <%= f.label :name, class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "Production Cloudflare" %>
    </div>

    <div>
      <%= f.label :provider, class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
      <%= f.select :provider, Credential::PROVIDERS.map { |p| [p.titleize, p] }, { include_blank: "Select provider" }, class: "mt-1 block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary", data: { credential_form_target: "provider", action: "change->credential-form#update" } %>
    </div>

    <div>
      <%= f.label :api_key, "API key", class: "block font-mono text-2xs uppercase tracking-label text-muted", data: { credential_form_target: "apiKeyLabel" } %>
      <%= f.text_field :api_key, class: "mt-1 block w-full rounded-control border-border-strong font-mono text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "sk_live_..." %>
      <p class="mt-1 text-2xs text-muted">This value is encrypted at rest.</p>
    </div>

    <div data-credential-form-target="apiSecretGroup">
      <%= f.label :api_secret, "API secret", class: "block font-mono text-2xs uppercase tracking-label text-muted", data: { credential_form_target: "apiSecretLabel" } %>
      <%= f.text_field :api_secret, class: "mt-1 block w-full rounded-control border-border-strong font-mono text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "Secret" %>
      <p class="mt-1 text-2xs text-muted">For providers that require both key and secret.</p>
    </div>

    <div data-credential-form-target="accountIdGroup">
      <%= f.label :account_id, "Account ID (optional)", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
      <%= f.text_field :account_id, class: "mt-1 block w-full rounded-control border-border-strong font-mono text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "Cloudflare account id" %>
      <p class="mt-1 text-2xs text-muted">Cloudflare account id — required for R2 backups (the endpoint host) and set automatically when you Verify a Cloudflare token.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div data-credential-form-target="regionGroup">
        <%= f.label :region, "Region (optional)", class: "block font-mono text-2xs uppercase tracking-label text-muted", data: { credential_form_target: "regionLabel" } %>
        <%= f.text_field :region, class: "mt-1 block w-full rounded-control border-border-strong font-mono text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "us-east-1 · auto · us-west-004", data: { credential_form_target: "regionInput" } %>
        <p class="mt-1 text-2xs text-muted">S3 region / SES region / Wasabi / B2 / Spaces. R2 uses <code>auto</code>. <span data-credential-form-target="regionHint"></span></p>
      </div>
      <div data-credential-form-target="endpointGroup">
        <%= f.label :endpoint, "Custom endpoint (optional)", class: "block font-mono text-2xs uppercase tracking-label text-muted" %>
        <%= f.text_field :endpoint, class: "mt-1 block w-full rounded-control border-border-strong font-mono text-sm shadow-soft focus:border-primary focus:ring-primary", placeholder: "https://minio.internal:9000" %>
        <p class="mt-1 text-2xs text-muted">MinIO / self-hosted S3, or an SES SMTP host override. Managed vendors derive it.</p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= f.check_box :active, class: "h-4 w-4 rounded border-border-strong text-ink focus:ring-primary" %>
      <%= f.label :active, "Active", class: "text-sm font-medium text-body" %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-4">
    <%= link_to "Cancel", credentials_path, class: "text-sm font-medium text-body hover:text-ink" %>
    <%= f.submit credential.persisted? ? "Update Credential" : "Create Credential", class: "inline-flex items-center rounded-control bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-body cursor-pointer" %>
  </div>
<% end %>
