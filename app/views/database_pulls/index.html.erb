<% content_for :title, "Database pulls · Conductor" %>

<% failed = @pulls.count { |p| p.status == "failed" } %>
<%= render layout: "shared/page_head",
      locals: {
        title: failed.positive? ? "#{pluralize(failed, "pull")} failed." : "#{pluralize(@pulls.size, "pull")} on this host.",
        lede: "Dumps pulled from your servers down to the machine Conductor runs on — for a local restore, an inspection, or a copy of production data.",
        stats: [
          { value: @pulls.size, label: "pulls" },
          { value: @pulls.count { |p| p.status == "success" }, label: "succeeded" },
          ({ value: failed, label: "failed", tone: :danger } if failed.positive?)
        ].compact
      } do %>
  <%= rui_button("New pull", url: new_database_pull_path, color: :primary, size: :md) %>
<% end %>

<section class="max-w-7xl mx-auto px-4 py-8">
  <% if @pulls.any? %>
    <%= render layout: "shared/panel", locals: { title: "Pulls", flush: true } do %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="bg-fill font-mono text-2xs uppercase tracking-label text-muted">
              <th class="px-5 py-2 text-left font-semibold">#</th>
              <th class="px-5 py-2 text-left font-semibold">Source</th>
              <th class="px-5 py-2 text-left font-semibold">Server</th>
              <th class="px-5 py-2 text-left font-semibold">Restored into</th>
              <th class="px-5 py-2 text-left font-semibold">Size</th>
              <th class="px-5 py-2 text-left font-semibold">Status</th>
              <th class="px-5 py-2 text-right font-semibold">When</th>
            </tr>
          </thead>
          <tbody>
            <% @pulls.each do |pull| %>
              <tr class="border-t border-border hover:bg-bg-alt">
                <td class="px-5 py-2.5">
                  <%= link_to "##{pull.id}", database_pull_path(pull), class: "font-mono text-2xs font-medium text-ink hover:underline" %>
                </td>
                <td class="px-5 py-2.5 text-sm text-body"><%= pull.source_label %></td>
                <td class="px-5 py-2.5 font-mono text-2xs text-muted"><%= pull.server&.name || "—" %></td>
                <td class="px-5 py-2.5 font-mono text-2xs text-muted"><%= pull.restore_target.presence || "—" %></td>
                <td class="px-5 py-2.5 font-mono text-2xs text-muted"><%= pull.formatted_size %></td>
                <td class="px-5 py-2.5">
                  <span class="font-mono text-2xs font-semibold <%= { "success" => "text-primary", "failed" => "text-danger", "running" => "text-warning-deep" }[pull.status] || "text-muted" %>">
                    <%= pull.status %>
                  </span>
                </td>
                <td class="px-5 py-2.5 text-right font-mono text-2xs text-faint"><%= time_ago_in_words(pull.created_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-large border border-dashed border-border-strong bg-fill p-12 text-center">
      <h2 class="font-display text-xl text-ink">No pulls yet</h2>
      <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
        Pull a production database down to restore it locally — the same dump path the
        backups use, so a successful pull is also evidence the backup would restore.
      </p>
      <%= rui_button "Pull a database", url: new_database_pull_path, color: :primary, class: "mt-5" %>
    </div>
  <% end %>
</section>
