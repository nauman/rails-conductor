<%= render partial: "shared/page_head",
      locals: {
        title: "#{pluralize(@memberships.size, "member")} in #{current_organization.name}.",
        lede: "Owners can invite and remove people and manage everything in this organization.",
        stats: [
          { value: @memberships.size, label: "members" },
          { value: @memberships.count(&:owner?), label: "owners" },
          ({ value: @invitations.size, label: "invites pending", tone: :warning } if @invitations.any?)
        ].compact
      } %>

<section class="max-w-3xl mx-auto px-4 py-8 space-y-5">
  <% if @can_manage %>
    <%= render layout: "shared/panel", locals: { title: "Invite someone" } do %>
      <%= form_with url: invitations_path, method: :post, scope: :invitation, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="min-w-48 flex-1">
          <%= f.label :email, "Email", class: "mb-1 block font-mono text-2xs uppercase tracking-label text-muted" %>
          <%= f.email_field :email, required: true, placeholder: "teammate@example.com",
                class: "block w-full rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
        </div>
        <div>
          <%= f.label :role, "Role", class: "mb-1 block font-mono text-2xs uppercase tracking-label text-muted" %>
          <%= f.select :role, [ [ "Member", "member" ], [ "Owner", "owner" ] ], {},
                class: "block rounded-control border-border-strong text-sm shadow-soft focus:border-primary focus:ring-primary" %>
        </div>
        <%= f.submit "Send invite", class: "cursor-pointer rounded-control bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-strong" %>
      <% end %>
    <% end %>
  <% end %>

  <%= render layout: "shared/panel", locals: { title: "People", flush: true } do %>
    <div class="divide-y divide-border">
      <% @memberships.each do |membership| %>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium text-ink"><%= membership.user.email %></span>
            <%= rui_badge(text: membership.role, color: membership.owner? ? :primary : :slate, size: :sm) %>
            <% if membership.user_id == current_user.id %>
              <span class="font-mono text-2xs text-faint">you</span>
            <% end %>
          </div>
          <% if @can_manage && membership.user_id != current_user.id %>
            <%= rui_button_to("Remove", member_path(membership), method: :delete, variant: :ghost, size: :sm, color: :danger,
                  data: { turbo_confirm: "Remove #{membership.user.email}?" }) %>
          <% end %>
        </div>
      <% end %>

      <% @invitations.each do |invitation| %>
        <div class="flex items-center justify-between gap-3 bg-bg-alt px-5 py-3">
          <div class="flex items-center gap-2">
            <span class="text-sm text-body"><%= invitation.email %></span>
            <%= rui_badge(text: "invited · #{invitation.role}", color: :warning, size: :sm) %>
          </div>
          <span class="font-mono text-2xs text-faint">hasn't accepted yet</span>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
